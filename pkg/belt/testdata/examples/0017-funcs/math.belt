// The exporter: public functions, including an overloaded name.

/// Doubles x.
pub fn double(x: nint): nint -> x * 2

/// The area of a w-by-h rectangle.
pub fn area(w: nint, h: nint): nint -> w * h

/// Greets by name.
pub fn greet(name: string): string -> "Hello, " + name

/// Scales an nint.
pub fn scale(x: nint): nint -> x * 10
/// Scales every element of a list.
pub fn scale(xs: list<nint>): list<nint> -> xs.map(fn(x) -> x * 10)

// A private helper does not export.
fn hidden(): nint -> 0
