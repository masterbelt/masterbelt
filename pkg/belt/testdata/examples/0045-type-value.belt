// Type values, field-type projection, and the storage rule. Every type symbol
// is, in value position, a compile-time value — immutable, side-effect-free, of
// the builtin type `type` (the metatype, type : type). Type values are
// comptime-only: they fold and are gone before any runtime. They can be
// *consumed* by a comptime expression — an assert, a comparison — but never
// *stored*: a const, let, field, parameter, or result whose type is `type` is
// rejected, so a type value cannot escape into a runtime slot. A projected field
// type is named with a type alias or reused in a type position, never bound to a
// value.

/// A character level, a nominal alias the schema shares.
pub type Level = sbyte

/// A structural record. Its fields' declared types — long, Level — are what a
/// projection off it recovers, with nominal identity intact.
pub type Item = {
  id: long,
  level: Level,
}

/// A second record reusing Item's field types by projection in type position:
/// rank is exactly Item.level, the declared alias Level — change Level once and
/// both records follow (schema DRY). A projection is a type, so it stands in a
/// type position; it is never stored in a value.
pub type Mob = {
  id: Item.id,
  rank: Item.level,
}

/// A type alias naming a projected field type directly — Item's id column type,
/// kept in one place rather than repeated.
pub type ItemId = Item.id

// Type values are consumed, not stored. An assert is a comptime test that is
// never codegen'd, so reading a type value in one is safe: == compares two type
// values by nominal identity, so Level is not the sbyte it aliases.

/// The projected field type is the declared one.
assert Item.id == long

/// Nominal identity is preserved: Item.level is Level, not its sbyte base.
assert Item.level == Level

/// A bare type name reifies to a type value too, so two names compare directly.
assert Level != long

// A column literally named `type` — a reserved word read as an identifier in
// field-name position — is the masterdata edge the keyword unlocks. Its declared
// type is an ordinary type, because a field is a value slot and a value slot's
// type may not be the metatype.

/// A schema with a column named `type`, whose declared type is an ordinary type.
pub type Schema = {
  type: Level,
}

/// A type alias projecting that keyword-named column in type position — the
/// keyword read as a member name after the dot, exactly as in value position.
pub type SchemaType = Schema.type

/// That column's declared type, recovered by projection in value position too.
assert Schema.type == Level

// A getter is a readable member too. It is read as `.X` (no parens), the same as
// a field, so it projects the same way: R.X recovers the type of what r.X reads,
// over fields and getters alike. The projection is the type-facet of the read.

/// A record with a getter over its field.
pub type Cell = {
  raw: Level,
} impl {
  /// Read as cell.scaled (no parens), like a field.
  pub get scaled(): Level {
    return self.raw
  }
}

/// The getter's result type, recovered by projection in type position — exactly
/// as a field projection (Item.level) recovers a field's declared type.
pub type Scaled = Cell.scaled

/// And consumed in value position: the same projection, by nominal identity.
assert Cell.scaled == Level
assert Cell.scaled != long
