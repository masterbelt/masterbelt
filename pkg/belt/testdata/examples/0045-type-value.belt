// Type values. Every type symbol is, in value position, a compile-time value —
// immutable, side-effect-free, of the builtin type `type` (the metatype, with
// type : type). A bare type name reifies to one (const t = sbyte), and the
// `type` keyword names the metatype as a value. Type values exist only at
// compile time: they fold and are gone before any runtime. This is the basis the
// masterdata layer is rebuilt on (a master is a type value with a master
// descriptor); 0001 lands the representation, member resolution unifies onto it,
// and the projections (Character.level, generics) come in the slices after.

/// A character level, a nominal alias the schema shares.
pub type Level = sbyte

/// A builtin type, reified: the value is sbyte, its own type is `type`.
pub const sbyte_t = sbyte

/// A nominal type, reified: the declared identity is preserved (Level, not the
/// sbyte it aliases) — type values carry nominal identity, not structure.
pub const level_t = Level

/// The metatype carried as a written annotation — the value flows in at `type`.
pub const annotated: type = Level

/// The metatype itself, as a value: type is a value of type type.
pub const meta = type

/// A type value passed on by reference, still of type `type`.
pub const same_level = level_t
