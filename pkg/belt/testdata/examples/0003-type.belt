// Nominal type
/// A coin denomination.
pub type Coin = sbyte

// Nominal type with methods
/// A character level.
pub type Level = sbyte impl {
  /// The next level up.
  pub increment(): self {
    return self + 1
  }
}

// Union type
/// Any value the game can score: a Coin or a Level.
pub type GameValue = Coin | Level

// Generics
/// A T, or nothing.
pub type Optional<T> = T | null

// Generics with type constraint
/// A small integer, or nothing.
pub type OptionalNumeric<T: sbyte | short> = T | null

// Product type
/// One saved character: an id and its level.
pub type Record = {
  id: sbyte,
  level: Level,
} impl {
  /// The record's id widened into the game's id space.
  pub fn game_id(): int {
    return int(self.id) * 1000
  }
}

// Function type
/// A mapping from T to R.
pub type Mapper<T, R> = fn(src: T): R
