// The list stack/queue methods — push, pop, unshift, shift — and the element
// overload of +. list + list stays the concatenation (add(other: self));
// list + element appends the one value (add(element: T)), so [1, 2] + 3 is
// [1, 2, 3] with no wrapping at the call site. Data stays immutable
// throughout: push and unshift return a new list, and the taking reads pop
// and shift yield optional<T> — the element, or null when the list is empty —
// never mutating the receiver.

// + over two lists concatenates, as before.
const Joined = [1, 2] + [3, 4]          // [1, 2, 3, 4]

// + with an element appends it: the add(element: T) overload.
const Added = [1, 2] + 3                // [1, 2, 3]

// The overloads resolve by the operand's type even when T is itself a list:
// [3] is one element of list<list<nint>>, so it appends as one element.
const NestedAdd = [[1], [2]] + [3]      // [[1], [2], [3]]

// push is the method spelling of the element append (the old append, renamed).
const Pushed = [1, 2].push(3)           // [1, 2, 3]

// unshift is push's front-side mirror: the element goes first.
const Unshifted = [2, 3].unshift(1)     // [1, 2, 3]

// pop reads the last element, shift the first. Each yields optional<T> — the
// element when one exists, null when the list is empty — so an empty read is
// a value to branch on, not an error.
const Empty: list<nint> = []
const Last = [1, 2, 3].pop()            // 3
const NoLast = Empty.pop()              // null
const First = [1, 2, 3].shift()         // 1
const NoFirst = Empty.shift()           // null

// match narrows the optional result, so a folded element flows on as nint.
pub fn orZero(v: optional<nint>): nint {
  match v {
    nint n -> return n
    null  -> return 0
  }
}

// Every folded result verifies in an assertion at compile time.
assert ([1, 2] + [3, 4]).len() == 4
assert ([1, 2] + 3).len() == 3
assert [1, 2].push(3).len() == 3
assert [2, 3].unshift(1).len() == 3
assert ([[1], [2]] + [3]).len() == 3
assert orZero([1, 2, 3].pop()) == 3
assert orZero(Empty.pop()) == 0
assert orZero([1, 2, 3].shift()) == 1
assert orZero(Empty.shift()) == 0
