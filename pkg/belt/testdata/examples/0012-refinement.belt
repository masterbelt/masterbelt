// Refinement types: a where-clause constrains a nominal type to the
// values that satisfy its predicate. The predicate is folded at compile
// time with self bound to each annotated constant's value.

/// A character level between 0 and 100.
pub type Level = sbyte where self >= 0 && self <= 100

/// A TCP port number.
pub type Port = int where self >= 1 && self <= 65535

// A where-clause composes with an impl block.
/// A percentage from 0 to 100.
pub type Percent = sbyte where self >= 0 && self <= 100 impl {
  /// The next percentage point.
  pub increment(): self {
    return self + 1
  }
}

// A where-clause may call a method of the type it refines: self is the nominal
// type, so its own methods resolve, and the predicate folds through the method
// body at compile time.
/// A score that is valid only when it lies in the 0..100 band.
pub type Score = int where self.inBand() impl {
  /// Whether the score is within the valid band.
  pub inBand(): bool {
    return self >= 0 && self <= 100
  }
}

// Annotated constants are checked against their type's predicate.
const ServerPort: Port = 8080
const MinPort: Port = 1
const MaxPort: Port = 65535
const FullLevel: Level = 100

// A self-method predicate gates an annotated constant the same way: ValidScore
// satisfies inBand(), so it passes.
const ValidScore: Score = 75

// An unannotated constant is a plain nint: no refinement applies.
const Unrefined = 70000
