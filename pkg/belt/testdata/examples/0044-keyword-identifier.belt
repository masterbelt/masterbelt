// Keywords as ordinary identifiers. A reserved word reads as a name at the three
// positions the grammar makes unambiguous: a member access after ".", a record
// field name, and a function parameter name. The lexer still lexes `type` and
// `for` as keywords; the parser accepts them as names where no keyword construct
// can begin (item.type, { type: ... }, fn(for: int)), so masterdata columns and
// generated signatures may carry those spellings without the lexer reserving an
// exception per word. The let/loop binding names and the declaration names keep
// requiring a plain identifier, where a keyword would collide with the construct
// it heads (type Foo = ...).

/// How a skill triggers.
pub enum SkillKind {
  active
  passive
}

/// A skill row whose trigger lives in a column literally named `type`, beside a
/// handler whose parameter is the reserved word `for`.
pub type SkillRow = {
  type: SkillKind,
  handler: fn(for: int): int,
}

/// The row's trigger kind, read through the keyword-named field with `.type`.
pub fn trigger_of(row: SkillRow): SkillKind {
  return row.type
}

/// A parameter named `for` — a reserved word read as an ordinary name. It is
/// declarable here even though a bare `for` in value position would open a loop.
pub fn doubled(for: int): int {
  return 2 * 2
}
