Module
  Consts: ~
  Types:
    TypeDef
      Name: "Level"
      Anchor: "belt:/Level"
      Public: true
      Doc: "A character level, a nominal alias the schema shares."
      Params: ~
      Body: Builtin
        Name: "sbyte"
      Methods: ~
      Consts: ~
      Builtin: false
      Interface: ~
      Impls: ~
      Enum: ~
      Master: ~
      Where: ~
    TypeDef
      Name: "Item"
      Anchor: "belt:/Item"
      Public: true
      Doc: "A structural record. Its fields' declared types — long, Level — are what a" "projection off it recovers, with nominal identity intact."
      Params: ~
      Body: Record
        Fields:
          Field
            Name: "id"
            Type: Builtin
              Name: "long"
          Field
            Name: "level"
            Type: Named
              Def: "Level"
      Methods: ~
      Consts: ~
      Builtin: false
      Interface: ~
      Impls: ~
      Enum: ~
      Master: ~
      Where: ~
    TypeDef
      Name: "Mob"
      Anchor: "belt:/Mob"
      Public: true
      Doc: "A second record reusing Item's field types by projection in type position:" "rank is exactly Item.level, the declared alias Level — change Level once and" "both records follow (schema DRY). A projection is a type, so it stands in a" "type position; it is never stored in a value."
      Params: ~
      Body: Record
        Fields:
          Field
            Name: "id"
            Type: Builtin
              Name: "long"
          Field
            Name: "rank"
            Type: Named
              Def: "Level"
      Methods: ~
      Consts: ~
      Builtin: false
      Interface: ~
      Impls: ~
      Enum: ~
      Master: ~
      Where: ~
    TypeDef
      Name: "ItemId"
      Anchor: "belt:/ItemId"
      Public: true
      Doc: "A type alias naming a projected field type directly — Item's id column type," "kept in one place rather than repeated."
      Params: ~
      Body: Builtin
        Name: "long"
      Methods: ~
      Consts: ~
      Builtin: false
      Interface: ~
      Impls: ~
      Enum: ~
      Master: ~
      Where: ~
    TypeDef
      Name: "Schema"
      Anchor: "belt:/Schema"
      Public: true
      Doc: "A schema with a column named `type`, whose declared type is an ordinary type."
      Params: ~
      Body: Record
        Fields:
          Field
            Name: "type"
            Type: Named
              Def: "Level"
      Methods: ~
      Consts: ~
      Builtin: false
      Interface: ~
      Impls: ~
      Enum: ~
      Master: ~
      Where: ~
  Funcs: ~
  Asserts:
    Assert
      Cond: "Item.id == long"
      Doc: "The projected field type is the declared one."
      Eval: Constant
        Kind: 1
        Int: ~
        Bool: true
        Str: ""
        Coll: ~
        Fields: ~
