        End: ~
        Step: ~
        UnionTag: ~
        Reified: ~
      Diagram: "Item.level == Level\n     ^     ^  ^\n     Level |  Level\n           true"
    Assert
      Cond: "Level != long"
      Doc: "A bare type name reifies to a type value too, so two names compare directly."
      Eval: Constant
        Kind: 1
        Int: ~
        Bool: true
        Str: ""
        Coll: ~
        Fields: ~
        CollMapness: 0
        Millis: 0
        Fn: ~
        Captured: ~
        EnumDef: ~
        EnumIndex: 0
        Start: ~
        End: ~
        Step: ~
        UnionTag: ~
        Reified: ~
      Diagram: "Level != long\n^     ^  ^\nLevel |  long\n      true"
    Assert
      Cond: "Schema.type == Level"
      Doc: "That column's declared type, recovered by projection — the keyword read as a" "member name after the dot."
      Eval: Constant
        Kind: 1
        Int: ~
        Bool: true
        Str: ""
        Coll: ~
        Fields: ~
        CollMapness: 0
        Millis: 0
        Fn: ~
