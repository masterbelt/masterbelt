      Diagram: "Item.id == long\n     ^  ^  ^\n     |  |  long\n     |  true\n     long"
    Assert
      Cond: "Item.level == Level"
      Doc: "Nominal identity is preserved: Item.level is Level, not its sbyte base."
      Eval: Constant
        Kind: 1
        Int: ~
        Bool: true
        Str: ""
        Coll: ~
        Fields: ~
        CollMapness: 0
        Millis: 0
        Fn: ~
        Captured: ~
        EnumDef: ~
        EnumIndex: 0
