/// An ordered sequence of T values, written [a, b, c].
pub type list<T> = builtin<T> impl {
  /// The number of elements.
  pub extern fn len(): nint

  /// A new list: func applied to each element, in order.
  pub extern fn map(func: fn(item: T): R): list<R>

  /// A new list with value pushed at the end, leaving this one unchanged.
  pub extern fn push(value: T): self

  /// The last element, or null when the list is empty. The taking read is a
  /// value to branch on, not an error; the receiver stays unchanged.
  pub extern fn pop(): optional<T>

  /// A new list with value at the front, leaving this one unchanged.
  pub extern fn unshift(value: T): self

  /// The first element, or null when the list is empty. The taking read is a
  /// value to branch on, not an error; the receiver stays unchanged.
  pub extern fn shift(): optional<T>

  /// The element at index, or an error when the index is out of range. The
  /// result is a union (T | error) because a read can miss; handle the error.
  pub extern fn get(index: nint): T | error

  /// A new list with index replaced by value, leaving this one unchanged. An
  /// index past the end is a compile-time error (index_out_of_range).
  pub extern fn set(index: nint, value: T): self

  /// The + operator: the concatenation.
  pub extern fn add(other: self): self

  /// The + operator with one element: a new list with it pushed at the end,
  /// so [1, 2] + 3 is [1, 2, 3].
  pub extern fn add(element: T): self
} impl comparable {
  /// The == operator: element-wise equality.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl foldable<nint, T> {
  /// The required primitive: visit each element with its index as the key,
  /// threading the accumulator. The provided count/any/all/map/filter/... are
  /// defined on top of this.
  pub extern fn fold(init: A, step: fn(acc: A, key: nint, value: T): A): A
}
