// The operator contracts: the named interfaces a type opts into to carry the
// comparison and arithmetic operators. They are gathered here, apart from any one
// type, because they cut across the whole numeric and ordered family — bool,
// the integers, string, datetime, duration — and a generic bound (T: orderable)
// reads better naming the contract than naming a type that happens to have the
// methods. Each member is an operator's method; a type writes `impl orderable`
// at its own definition site and declares the members there.

/// Equality: the == and != operators. Every value that can be compared for
/// sameness conforms.
pub interface comparable {
  /// The == operator.
  eql(other: self): bool
  /// The != operator.
  neq(other: self): bool
}

/// A total order: the <, <=, >, >= operators, layered on comparable's equality.
/// orderable inherits comparable, so an ordered value is comparable too — a
/// bound of orderable carries eql/neq, and a switch over an orderable-bounded
/// type parameter dispatches on the equality comparable supplies.
pub interface orderable: comparable {
  /// The < operator.
  lt(other: self): bool
  /// The <= operator.
  lteq(other: self): bool
  /// The > operator.
  gt(other: self): bool
  /// The >= operator.
  gteq(other: self): bool
}

/// Arithmetic: the unary + and the binary +, -, *, /, % operators. The unary -
/// (neg) is deliberately absent — an unsigned integer has no negation, so it sits
/// on the signed types' own impl blocks rather than in this shared contract.
pub interface numeric {
  /// The unary + operator: the value unchanged.
  pos(): self

  /// The + operator: the sum.
  add(other: self): self
  /// The - operator: the difference.
  sub(other: self): self
  /// The * operator: the product.
  mul(other: self): self
  /// The / operator: the quotient. A zero divisor is a compile-time error.
  div(other: self): self
  /// The % operator: the remainder. A zero divisor is a compile-time error.
  rem(other: self): self
}

/// The bitwise operations on an integer: and, or, xor, and the left/right
/// shifts. They are width-blind, like the arithmetic in numeric — a result that
/// does not fit a sized integer overflows at its assignment rather than wrapping
/// — so every integer kind conforms, signed and unsigned, sized and unbounded.
/// A signed value's bits are its two's complement. The complement is
/// deliberately not a member: ~x within a fixed width is width-bearing, so it
/// composes on top rather than sitting in this width-blind contract. For an
/// unsigned type it is x.bxor(T.Max) — T.Max being that type's all-ones; a
/// signed type's Max is its largest positive, not all-ones, so that recipe is
/// the unsigned one, not a general formula.
pub interface bitwise {
  /// The bitwise and.
  band(other: self): self
  /// The bitwise or.
  bor(other: self): self
  /// The bitwise exclusive or.
  bxor(other: self): self
  /// A left shift by amount: the value times two to the amount. A result past a
  /// sized integer's range overflows at its assignment (the shift does not wrap).
  shl(amount: nuint): self
  /// A right shift by amount. It is arithmetic — sign-extending — so on a
  /// negative value it floors toward minus infinity rather than truncating
  /// toward zero the way the / operator does.
  shr(amount: nuint): self
}
