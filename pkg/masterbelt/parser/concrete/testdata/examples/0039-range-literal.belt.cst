# tree
File
  ConstDecl
    LineComment "// Range literals and the three-argument range constructor. A range literal is"
    Newline "\n"
    LineComment "// the surface syntax for the range builtin (0034): a..b is the closed integer"
    Newline "\n"
    LineComment "// interval, a...b the half-open one (the larger end excluded), iterated from the"
    Newline "\n"
    LineComment "// a side toward the b side, so the direction follows the bounds. Each literal"
    Newline "\n"
    LineComment "// folds to exactly the range(start, end, step) construction it is equivalent to,"
    Newline "\n"
    LineComment "// and range gains a third, step argument: range(start, end, step) walks start,"
    Newline "\n"
    LineComment "// start+step, ..., while the value stays on the end side of the step. The two-"
    Newline "\n"
    LineComment "// argument range (0034) is unchanged — its step is 1."
    Newline "\n"
    Newline "\n"
    LineComment "// The four literal forms, each folding to the range value it equals."
    Newline "\n"
    LineComment "//  0..9   closed, ascending:  range(0, 9)        — 0,1,...,9"
    Newline "\n"
    LineComment "//  0...9  half-open (max 9 excluded), ascending:  range(0, 8)  — 0,1,...,8"
    Newline "\n"
    LineComment "//  9..0   closed, descending: range(9, 0, -1)    — 9,8,...,0"
    Newline "\n"
    LineComment "//  9...0  half-open (max 9 excluded), descending: range(8, 0, -1) — 8,7,...,0"
    Newline "\n"
