File
  TypeDecl
    doc "A small ordered, printable, rankable tag value."
    pub
    name "Tag"
    body nint
    impl ordered
    method "show"
      doc "Render the tag."
      result string
      return StringLit "tag"
    method "rank"
      doc "The tag's rank."
      result nint
      return IntLit "1"
    method "before"
      doc "Order tags by value."
      param other: self
      result bool
      return (call (. self lt) Identifier "other")
  InterfaceDecl
    doc "A behaviour layered on a parent: a printable value is comparable, so it"
    doc "carries eql/neq (from comparable) on top of its own show."
    pub
    name "printable"
  InterfaceDecl
    doc "A diamond: ordered inherits comparable through two distinct parents"
    doc "(printable and rankable, each comparable). The shared ancestor is deduped by"
    doc "definition identity, so ordered's contract carries comparable's members once."
    pub
    name "rankable"
  InterfaceDecl
    doc "The join of two comparable-derived parents: a single shared comparable"
    doc "ancestor, reached two ways — the diamond closes cleanly."
    pub
    name "ordered"
  FuncDecl
    doc "Whether two ordered values are equal, via comparable inherited by ordered."
    pub
    name "equal"
    typeparam T: ordered
    param a: T
    param b: T
    result bool
      return (call (. Identifier "a" eql) Identifier "b")
