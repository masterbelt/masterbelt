  TypeDecl
    doc "A small bag of ints that folds over its contents — an opt-in implementor of"
    doc "foldable, so it satisfies a `T: foldable<nint, nint>` bound."
    pub
    name "Bag"
    body list<nint>
    impl foldable<nint, nint>
    method "fold"
      typeparam A
      param init: A
      param step: fn(acc: A, key: nint, value: nint): A
      result A
      return Identifier "init"
  InterfaceDecl
    doc "A behaviour over a keyed collection: the required fold, plus the provided"
    doc "count derived from it. The same prelude-style interface a bound refers to."
    pub
    name "foldable"
    param K
    param V
    required "fold"
      typeparam A
      param init: A
      param step: fn(acc: A, key: K, value: V): A
      result A
    provided "count"
      doc "Provided: the number of elements, folded from the primitive."
      pub
      result nint
      return (call Identifier "fold" IntLit "0" (fn(acc: <missing>, key: <missing>, value: <missing>): <missing> (return (call (. Identifier "acc" add) IntLit "1"))))
  FuncDecl
    doc "The total of any foldable collection of ints, folded with addition."
    pub
    name "total"
    typeparam T: foldable<nint, nint>
    param c: T
    result nint
      return (call (. Identifier "c" fold) IntLit "0" (fn(acc: <missing>, key: <missing>, value: <missing>): <missing> (return (call (. Identifier "acc" add) Identifier "value"))))
  FuncDecl
    doc "The argument, unchanged. Works for any type because it touches nothing."
    pub
    name "identity"
    typeparam T
    param x: T
    result T
      return Identifier "x"
  FuncDecl
    doc "The first of two values of the same type."
    pub
    name "firstOf"
    typeparam T
    param a: T
    param b: T
    result T
      return Identifier "a"
