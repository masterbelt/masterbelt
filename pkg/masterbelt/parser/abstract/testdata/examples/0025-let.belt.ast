File
  ConstDecl
    name "Picked"
    value (call Identifier "pick" BoolLit true)
  ConstDecl
    name "Stepped"
    value (call Identifier "step" IntLit "41")
  FuncDecl
    pub
    name "pick"
    param flag: bool
    result int
      if Identifier "flag"
      return Identifier "result"
  FuncDecl
    pub
    name "step"
    param n: int
    result int
      return Identifier "acc"
  FuncDecl
    pub
    name "shadow"
    param flag: bool
    result int
      if Identifier "flag"
          return Identifier "result"
      return Identifier "result"
  AssertDecl
    cond (call (. (call Identifier "pick" BoolLit false) eql) IntLit "10")
  AssertDecl
    cond (call (. (call Identifier "step" IntLit "41") eql) IntLit "42")
