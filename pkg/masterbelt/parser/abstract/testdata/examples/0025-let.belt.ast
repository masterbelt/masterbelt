File
  ConstDecl
    name "Picked"
    value (call Identifier "pick" BoolLit true)
  ConstDecl
    name "Stepped"
    value (call Identifier "step" IntLit "41")
  FuncDecl
    pub
    name "pick"
    param flag: bool
    result nint
      let "base" = IntLit "10"
      let "result" = Identifier "base"
      if Identifier "flag"
          assign Identifier "result" = (call (. Identifier "base" mul) IntLit "2")
      return Identifier "result"
  FuncDecl
    pub
    name "step"
    param n: nint
    result nint
      let "acc": nint = Identifier "n"
      assign Identifier "acc" = (call (. Identifier "acc" add) IntLit "1")
      return Identifier "acc"
  FuncDecl
    pub
    name "shadow"
    param flag: bool
    result nint
      let "result" = IntLit "1"
      if Identifier "flag"
          let "result" = IntLit "2"
          assign Identifier "result" = (call (. Identifier "result" add) IntLit "10")
          return Identifier "result"
      return Identifier "result"
  AssertDecl
    cond (call (. (call Identifier "pick" BoolLit false) eql) IntLit "10")
  AssertDecl
    cond (call (. (call Identifier "step" IntLit "41") eql) IntLit "42")
