File
  ConstDecl
    name "Present"
    type optional<nint>
    value IntLit "5"
  ConstDecl
    name "Absent"
    type optional<nint>
    value NullLit
  ConstDecl
    name "FromPresent"
    value (call Identifier "orZero" IntLit "5")
  ConstDecl
    name "FromAbsent"
    value (call Identifier "orZero" NullLit)
  ConstDecl
    name "WithFallback"
    value (call Identifier "orFallback" NullLit IntLit "99")
  FuncDecl
    pub
    name "orZero"
    param v: optional<nint>
    result nint
      match Identifier "v"
        arm nint n
          return Identifier "n"
        arm null
          return IntLit "0"
  FuncDecl
    pub
    name "orFallback"
    param v: optional<nint>
    param fallback: nint
    result nint
      match Identifier "v"
        arm nint n
          return Identifier "n"
        else
          return Identifier "fallback"
  AssertDecl
    cond (call (. (call Identifier "orZero" IntLit "5") eql) IntLit "5")
  AssertDecl
    cond (call (. (call Identifier "orZero" NullLit) eql) IntLit "0")
  AssertDecl
    cond (call (. (call Identifier "orFallback" IntLit "7" IntLit "99") eql) IntLit "7")
  AssertDecl
    cond (call (. (call Identifier "orFallback" NullLit IntLit "99") eql) IntLit "99")
