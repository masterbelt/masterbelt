File
  ConstDecl
    name "Held"
    type GameValue
    value (record Coin amount: IntLit "7")
  ConstDecl
    name "Total"
    value (call Identifier "worth" Identifier "Held")
  TypeDecl
    pub
    name "Coin"
    body { amount: nint }
  TypeDecl
    pub
    name "Level"
    body { rank: nint }
  TypeDecl
    pub
    name "GameValue"
    body Coin | Level
  FuncDecl
    pub
    name "describe"
    param v: GameValue
    result string
      match Identifier "v"
        arm Coin c
          return StringLit "coin"
        arm Level l
          return StringLit "level"
  FuncDecl
    pub
    name "worth"
    param v: GameValue
    result nint
      match Identifier "v"
        arm Coin c
          return (. Identifier "c" amount)
        arm Level l
          return (. Identifier "l" rank)
  FuncDecl
    pub
    name "amountOr"
    param v: Coin | null
    param fallback: nint
    result nint
      match Identifier "v"
        arm Coin c
          return (. Identifier "c" amount)
        arm null
          return Identifier "fallback"
  FuncDecl
    pub
    name "coinAmount"
    param v: GameValue
    result nint
      match Identifier "v"
        arm Coin c
          return (. Identifier "c" amount)
        else
          return IntLit "0"
  FuncDecl
    pub
    name "firstOr"
    param xs: list<nint>
    param fallback: nint
    result nint
      match (call (. Identifier "xs" get) IntLit "0")
        arm nint v
          return Identifier "v"
        arm error e
          return Identifier "fallback"
  FuncDecl
    pub
    name "label"
    param v: GameValue
    param other: GameValue
    result string
      match Identifier "v"
        arm Coin c
          let "n" = (. Identifier "c" amount)
          match Identifier "other"
            arm Coin c2
              return StringLit "coin/coin"
            arm Level l
              return StringLit "coin/level"
        arm Level l
          return StringLit "level"
