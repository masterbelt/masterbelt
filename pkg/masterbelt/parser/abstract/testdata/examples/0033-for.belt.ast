    pub
    name "sumEven"
    param xs: list<int>
    result int
      let "total" = IntLit "0"
      for x of Identifier "xs"
          if (call (. (call (. Identifier "x" rem) IntLit "2") eql) IntLit "0")
              assign Identifier "total" = (call (. Identifier "total" add) Identifier "x")
      return Identifier "total"
