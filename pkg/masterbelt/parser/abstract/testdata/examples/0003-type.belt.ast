File
  TypeDecl
    doc "A coin denomination."
    pub
    name "Coin"
    body int8
  TypeDecl
    doc "A character level."
    pub
    name "Level"
    body int8
    method "increment"
      doc "The next level up."
      pub
      result self
      return (call (. self add) IntLit "1")
  TypeDecl
    doc "Any value the game can score: a Coin or a Level."
    pub
    name "GameValue"
    body Coin | Level
  TypeDecl
    doc "A T, or nothing."
    pub
    name "Optional"
    param T
    body T | null
  TypeDecl
    doc "A small integer, or nothing."
    pub
    name "OptionalNumeric"
    param T: int8 | int16
    body T | null
  TypeDecl
    doc "One saved character: an id and its level."
    pub
    name "Record"
    body { id: int8, level: Level }
    method "game_id"
      doc "The record's id widened into the game's id space."
      pub
      result int32
      return (call (. (call Identifier "int32" (. self id)) mul) IntLit "1000")
  TypeDecl
    doc "A mapping from T to R."
    pub
    name "Mapper"
    param T
    param R
    body fn(src: T): R
