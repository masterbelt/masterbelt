File
  ConstDecl
    name "Bigger"
    value (call Identifier "max" IntLit "3" IntLit "7")
  ConstDecl
    name "Later"
    value (call Identifier "max" StringLit "a" StringLit "b")
  ConstDecl
    name "Equal"
    value (call Identifier "same" BoolLit true BoolLit false)
  ConstDecl
    name "Double"
    value (call Identifier "twice" IntLit "21")
  FuncDecl
    doc "The larger of two orderable values."
    pub
    name "max"
    typeparam T: orderable
    param a: T
    param b: T
    result T
      return (? (call (. Identifier "a" gteq) Identifier "b") Identifier "a" Identifier "b")
  FuncDecl
    doc "Whether two comparable values are equal."
    pub
    name "same"
    typeparam T: comparable
    param a: T
    param b: T
    result bool
      return (call (. Identifier "a" eql) Identifier "b")
  FuncDecl
    doc "A numeric value added to itself."
    pub
    name "twice"
    typeparam T: numeric
    param a: T
    result T
      return (call (. Identifier "a" add) Identifier "a")
