File
  FuncDecl
    doc "Doubles x."
    pub
    name "double"
    param x: nint
    result nint
      return (call (. Identifier "x" mul) IntLit "2")
  FuncDecl
    doc "The area of a w-by-h rectangle."
    pub
    name "area"
    param w: nint
    param h: nint
    result nint
      return (call (. Identifier "w" mul) Identifier "h")
  FuncDecl
    doc "Greets by name."
    pub
    name "greet"
    param name: string
    result string
      return (call (. StringLit "Hello, " add) Identifier "name")
  FuncDecl
    doc "Scales an nint."
    pub
    name "scale"
    param x: nint
    result nint
      return (call (. Identifier "x" mul) IntLit "10")
  FuncDecl
    doc "Scales every element of a list."
    pub
    name "scale"
    param xs: list<nint>
    result list<nint>
      return (call (. Identifier "xs" map) (fn(x: <missing>): <missing> (return (call (. Identifier "x" mul) IntLit "10"))))
  FuncDecl
    name "hidden"
    result nint
      return IntLit "0"
