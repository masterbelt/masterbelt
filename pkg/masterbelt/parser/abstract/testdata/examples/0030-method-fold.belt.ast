  TypeDecl
    doc "A character level, with methods over its underlying int8."
    pub
    name "Level"
    body int8
    method "increment"
      doc "The next level up — a self-returning method, so a chain keeps the type."
      pub
      result self
      return (call (. self add) IntLit "1")
    method "plus"
      doc "This level a number of steps up."
      pub
      param steps: int8
      result self
      return (call (. self add) Identifier "steps")
  EnumDecl
    doc "An elemental affinity, with methods that fold over a constant member."
    pub
    name "Element"
    member "Fire"
    member "Water"
    member "Wind"
    method "isFire"
      doc "Whether this element is Fire — a one-line body that folds to a bool."
      pub
      result bool
      return (call (. self eql) (. Identifier "Element" Fire))
    method "notFire"
      doc "Whether this element is not Fire — a method that calls another method."
      pub
      result bool
      return (call (. (call (. self isFire)) not))
    method "label"
      doc "A let- and if-bearing body, to exercise the full statement walker."
      pub
      result int
      let "fire" = (call (. self isFire))
      if Identifier "fire"
          return IntLit "1"
      return IntLit "0"
  FuncDecl
    doc "A function whose declared result type names Level — the chain channel."
    pub
    name "base"
    result Level
      return (call Identifier "Level" IntLit "1")
  AssertDecl
    cond (call (. (. Identifier "Element" Fire) isFire))
  AssertDecl
    cond (call (. (. Identifier "Element" Water) notFire))
  AssertDecl
    cond (call (. (call (. (. Identifier "Element" Fire) label)) eql) IntLit "1")
  AssertDecl
    cond (call (. (call (. (. Identifier "Element" Wind) label)) eql) IntLit "0")
  AssertDecl
    cond (call (. (call (. Identifier "Start" increment)) eql) IntLit "11")
  AssertDecl
    cond (call (. (call (. (call Identifier "base") plus) IntLit "4") eql) IntLit "5")
