  TypeDecl
    pub
    name "Clock"
    body { offset: duration }
    method "read"
      doc "The current instant, shifted by this clock's offset."
      pub
      effects nondet
      result datetime
      return (call (. (call (. Identifier "datetime" now)) add) (. self offset))
