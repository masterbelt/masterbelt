File
  FuncDecl
    pub
    name "clamp"
    param x: nint
    param lo: nint
    param hi: nint
    result nint
      if (call (. Identifier "x" lt) Identifier "lo")
          return Identifier "lo"
      else if (call (. Identifier "x" gt) Identifier "hi")
          return Identifier "hi"
      return Identifier "x"
  FuncDecl
    pub
    name "warn"
    param n: nint
    result nint
      if (call (. Identifier "n" gt) IntLit "100")
          return IntLit "0"
      return Identifier "n"
  FuncDecl
    pub
    name "sign"
    param n: nint
    result string
      if (call (. Identifier "n" gt) IntLit "0")
          return StringLit "positive"
      else
          if (call (. Identifier "n" lt) IntLit "0")
              return StringLit "negative"
          return StringLit "zero"
