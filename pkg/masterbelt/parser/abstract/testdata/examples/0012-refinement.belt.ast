  TypeDecl
    doc "A character level between 0 and 100."
    pub
    name "Level"
    body int8
    where (call (. (call (. self gteq) IntLit "0") anan) (call (. self lteq) IntLit "100"))
  TypeDecl
    doc "A TCP port number."
    pub
    name "Port"
    body int32
    where (call (. (call (. self gteq) IntLit "1") anan) (call (. self lteq) IntLit "65535"))
  TypeDecl
    doc "A percentage from 0 to 100."
    pub
    name "Percent"
    body int8
    where (call (. (call (. self gteq) IntLit "0") anan) (call (. self lteq) IntLit "100"))
    method "increment"
      doc "The next percentage point."
      pub
      result self
      return (call (. self add) IntLit "1")
  TypeDecl
    doc "A score that is valid only when it lies in the 0..100 band."
    pub
    name "Score"
    body int32
    where (call (. self inBand))
    method "inBand"
      doc "Whether the score is within the valid band."
      pub
      result bool
      return (call (. (call (. self gteq) IntLit "0") anan) (call (. self lteq) IntLit "100"))
