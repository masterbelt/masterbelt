// Effects declare a function's interaction with the world, in its signature:
// io touches it, async suspends (consumed explicitly with await), nondet does
// not reproduce. No declaration means pure — evaluated at compile time and
// folded to a value, as every belt expression has been. An effectful function
// is never folded; it compiles to runtime code for a target.

// The root of an effect is a native the toolchain's registry supplies — here
// datetime.now(), the current instant: nondet, because a wall-clock read does
// not reproduce. A root cannot be declared in user code: nothing there could
// supply its implementation.

// Effects propagate by declaration, never by silent inference: stamp calls
// datetime.now(), so it must declare nondet itself. A nondet wrapper stays
// nondet — the timestamp must never fold into a value.
pub fn nondet stamp(): datetime -> datetime.now()

// A method declares its effects the same way.
pub type Clock = { offset: duration } impl {
  /// The current instant, shifted by this clock's offset.
  pub fn nondet read(): datetime {
    return datetime.now() + self.offset
  }
}

// Undeclared effects mean pure: folded at compile time, as ever.
pub fn double(x: nint): nint -> x * 2
const A = double(21)

assert double(2) == 4
