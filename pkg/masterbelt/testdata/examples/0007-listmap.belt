// list<T>.map applies a function to every element, yielding a list<R>.

// Same element type: nint -> nint, written as an arrow lambda.
const Doubled = [1, 2, 3].map(fn(x: nint): nint -> x * 2)

// Changing element type: nint -> bool exercises the method type variable R,
// which is introduced by map and is not a parameter of list<T>.
const Evens = [1, 2, 3, 4].map(fn(x: nint): bool -> x % 2 == 0)
