// User-defined method calls fold at compile time: a method with a body is
// evaluated with self bound to the receiver, exactly as a top-level function
// call is. The folder reaches the method table without a type query — the
// receiver's type comes either from the value (an enum constant carries its
// definition) or syntactically from the declared annotation in scope (a nominal
// type over a primitive: a conversion's type name, a constant's annotation, a
// method's result), so methods fold in const initializers, asserts, and other
// pure positions.

/// An elemental affinity, with methods that fold over a constant member.
pub enum Element {
  Fire, Water, Wind
} impl {
  /// Whether this element is Fire — a one-line body that folds to a bool.
  pub isFire(): bool {
    return self == Element.Fire
  }

  /// Whether this element is not Fire — a method that calls another method.
  pub notFire(): bool {
    return !self.isFire()
  }

  /// A let- and if-bearing body, to exercise the full statement walker.
  pub label(): int {
    let fire = self.isFire()
    if fire {
      return 1
    }
    return 0
  }
}

// A method call folds in a const initializer.
const FireIsFire = Element.Fire.isFire()
const FireLabel = Element.Fire.label()
const WaterLabel = Element.Water.label()

// And in an assertion — the predicate folds to true at compile time.
assert Element.Fire.isFire()
assert Element.Water.notFire()
assert Element.Fire.label() == 1
assert Element.Wind.label() == 0

// A nominal type over a primitive: its value (an int8) carries no definition, so
// the receiver's static type is read from the declared annotation in scope.
/// A character level, with methods over its underlying int8.
pub type Level = int8 impl {
  /// The next level up — a self-returning method, so a chain keeps the type.
  pub increment(): self {
    return self + 1
  }
  /// This level a number of steps up.
  pub plus(steps: int8): self {
    return self + steps
  }
}

/// A function whose declared result type names Level — the chain channel.
pub fn base(): Level {
  return Level(1)
}

// A conversion names its type directly (channel 1): Level(5).increment() folds.
const Six: Level = Level(5).increment()

// A constant reference reads its annotation (channel 2): Start is a Level.
const Start: Level = 10
const Eleven = Start.increment()
const Thirteen = Start.plus(3)

// A call result reads the callee's result annotation (channel 5), and a chain of
// self-returning methods keeps the type: base() is a Level, so each step folds.
const Three = base().increment().increment()

// The nominal methods fold in assertions too.
assert Start.increment() == 11
assert base().plus(4) == 5
