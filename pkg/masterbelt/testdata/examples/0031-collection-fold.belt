// The collection primitives fold at compile time: list.len and map.len count
// entries, the native fold threads an accumulator over the entries (a list's key
// is the element index, a map's the entry key), and the foldable provided
// methods — count, any, all, map, filter, keys, values — fold through it. The
// folder reaches the provided method bodies through the collection's foldable
// impl without a type query, evaluating each body with self bound to the
// collection, exactly as it folds a concrete method.

// len counts the entries of a list and a map alike.
const ListLen = [1, 2, 3].len()
const MapLen = ["a": 1, "b": 2].len()

// The native fold threads an accumulator. Over a list the step sees the element
// index as its key; summing the values, then the indices, folds to a value.
const Sum = [1, 2, 3].fold(0, fn(acc: int, i: int, v: int): int -> acc + v)
const IndexSum = [10, 20, 30].fold(0, fn(acc: int, i: int, v: int): int -> acc + i)

// Over a map the step sees the entry key.
const MapSum = ["a": 1, "b": 2, "c": 3].fold(0, fn(acc: int, k: string, v: int): int -> acc + v)

// count is the provided method defined on top of fold.
const Count = [1, 2, 3, 4].count()

// any and all fold to bools.
const AnyBig = [1, 2, 3].any(fn(v: int): bool -> v > 2)
const AllPositive = [1, 2, 3].all(fn(v: int): bool -> v > 0)

// The list-returning provided methods fold to lists. map applies a function to
// each value, filter keeps the values satisfying a predicate.
const Doubled = [1, 2, 3].map(fn(v: int): int -> v * 2)
const Big = [1, 2, 3, 4].filter(fn(v: int): bool -> v > 2)

// keys and values read a map's entries in fold order; values on a list yields
// the elements.
const Keys = ["x": 1, "y": 2].keys()
const Values = ["x": 1, "y": 2].values()
const ListValues = [7, 8, 9].values()

// Every folded result verifies in an assertion at compile time.
assert [1, 2, 3].len() == 3
assert ["a": 1, "b": 2].len() == 2
assert [1, 2, 3].fold(0, fn(acc: int, i: int, v: int): int -> acc + v) == 6
assert [1, 2, 3, 4].count() == 4
assert [1, 2, 3].any(fn(v: int): bool -> v > 2)
assert [1, 2, 3].all(fn(v: int): bool -> v > 0)
