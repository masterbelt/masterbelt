// optional<T> is the prelude's name for a value that may be absent: the generic
// alias `type optional<T> = T | null`. It is an alias, not a wrapper — it carries
// no tag of its own, so it behaves in every respect exactly like the bare union
// T | null it stands for. A member value and the null literal both assign to it,
// match narrows it, and exhaustiveness sees through it. This example folds that
// flow end to end over optional<int>.

// A member value flows into the alias the way it flows into the bare union: the
// annotation optional<int> accepts an int, and the const folds to that int.
const Present: optional<int> = 5

// The null literal is the alias' other member, so it assigns too.
const Absent: optional<int> = null

// match dispatches the alias by runtime type, narrowing the int arm's binding to
// int and handling the absent case with the null member. The function is
// exhaustive over int | null with no wildcard, so it always returns.
pub fn orZero(v: optional<int>): int {
  match v {
    int n -> return n
    null  -> return 0
  }
}

// Both paths fold: a present value recovers its int, an absent one the fallback.
const FromPresent = orZero(5)
const FromAbsent = orZero(null)

// The wildcard "_" form is the catch-all the bare union also takes: it covers the
// null member, so the match is exhaustive with the single int arm plus "_".
pub fn orFallback(v: optional<int>, fallback: int): int {
  match v {
    int n -> return n
    _     -> return fallback
  }
}

const WithFallback = orFallback(null, 99)

// Every folded result verifies in a compile-time assertion.
assert orZero(5) == 5
assert orZero(null) == 0
assert orFallback(7, 99) == 7
assert orFallback(null, 99) == 99
