Module
  Const "Present"
    type optional<nint>
    value (IntLiteral "5" : nint)
    eval (nint) 5
  Const "Absent"
    type optional<nint>
    value <none>
    eval (null) null
  Const "FromPresent"
    type nint
    value (orZero((IntLiteral "5" : nint)) : nint)
    eval 5
  Const "FromAbsent"
    type nint
    value (orZero(<none>) : nint)
    eval 0
  Const "WithFallback"
    type nint
    value (orFallback(<none>, (IntLiteral "99" : nint)) : nint)
    eval 99
  Func "orZero" pub
    param v: optional<nint>
    result nint
      match (ParamRef "v" : optional<nint>)
        arm nint n
          return (LocalRef "n" : nint)
        arm null
          return (IntLiteral "0" : nint)
  Func "orFallback" pub
    param v: optional<nint>
    param fallback: nint
    result nint
      match (ParamRef "v" : optional<nint>)
        arm nint n
          return (LocalRef "n" : nint)
        else
          return (ParamRef "fallback" : nint)
  Assert "orZero(5) == 5"
    eval true
      orZero(5) == 5
      ^         ^
      5         true
  Assert "orZero(null) == 0"
    eval true
      orZero(null) == 0
      ^            ^
      0            true
  Assert "orFallback(7, 99) == 7"
    eval true
      orFallback(7, 99) == 7
      ^                 ^
      7                 true
  Assert "orFallback(null, 99) == 99"
    eval true
      orFallback(null, 99) == 99
      ^                    ^
      99                   true
