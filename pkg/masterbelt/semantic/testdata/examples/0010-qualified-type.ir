# geometry.belt
Module
  Const "Origin" pub
    doc "The zero point every path starts from."
    type int
    value IntLiteral "0"
    eval 0
  Const "Unit" pub
    doc "One step along the axis."
    type int
    value IntLiteral "1"
    eval 1
  TypeDef "Point" pub
    doc "A 1-D coordinate."
    body int32
# main.belt
Module
  Const "start"
    type Point
    value Reference -> "Origin"
    eval 0
  Const "path"
    type list<Point>
    value [Reference -> "Origin", Reference -> "Unit"]
    eval [0, 1]
