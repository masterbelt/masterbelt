# geometry.belt
Module
  Const "Origin" pub
    doc "The zero point every path starts from."
    type nint
    value (IntLiteral "0" : nint)
    eval 0
  Const "Unit" pub
    doc "One step along the axis."
    type nint
    value (IntLiteral "1" : nint)
    eval 1
  TypeDef "Point" pub
    doc "A 1-D coordinate."
    body int
# main.belt
Module
  Const "start"
    type Point
    value (Reference -> "Origin" : nint)
    eval 0
  Const "path"
    type list<Point>
    value ([(Reference -> "Origin" : nint), (Reference -> "Unit" : nint)] : list<Point>)
    eval [0, 1]
