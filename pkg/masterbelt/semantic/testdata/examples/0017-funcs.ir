# main.belt
Module
  Const "A"
    type nint
    value double(IntLiteral "21")
    eval 42
  Const "B"
    type nint
    value area(IntLiteral "3", IntLiteral "4")
    eval 12
  Const "C"
    type nint
    value scale(IntLiteral "4")
    eval 40
  Const "D"
    type list<nint>
    value scale([IntLiteral "1", IntLiteral "2"])
    eval [10, 20]
  Const "E"
    type string
    value greet(StringLiteral "belt")
    eval "Hello, belt"
  Assert "math.double(2) == double(2)"
    eval true
      math.double(2) == double(2)
           ^         ^  ^
           4         |  4
                     true
# math.belt
Module
  Func "double" pub
    doc "Doubles x."
    param x: nint
    result nint
      return ParamRef "x".mul(IntLiteral "2")
  Func "area" pub
    doc "The area of a w-by-h rectangle."
    param w: nint
    param h: nint
    result nint
      return ParamRef "w".mul(ParamRef "h")
  Func "greet" pub
    doc "Greets by name."
    param name: string
    result string
      return StringLiteral "Hello, ".add(ParamRef "name")
  Func "scale" pub
    doc "Scales an nint."
    param x: nint
    result nint
      return ParamRef "x".mul(IntLiteral "10")
  Func "scale" pub
    doc "Scales every element of a list."
    param xs: list<nint>
    result list<nint>
      return ParamRef "xs".map((fn(x) (return ParamRef "x".mul(IntLiteral "10"))))
  Func "hidden"
    result nint
      return IntLiteral "0"
