Module
  Const "A"
    type nint
    value double(IntLiteral "21")
    eval 42
  TypeDef "Clock" pub
    body { offset: duration }
    method "read" pub
      doc "The current instant, shifted by this clock's offset."
      effects nondet
      result datetime
      return datetime.now().add(self.offset)
  Func "stamp" pub
    effects nondet
    result datetime
      return datetime.now()
  Func "double" pub
    param x: nint
    result nint
      return ParamRef "x".mul(IntLiteral "2")
  Assert "double(2) == 4"
    eval true
      double(2) == 4
      ^         ^
      4         true
