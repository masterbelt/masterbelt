Module
  Const "A"
    type int
    value double(IntLiteral "21")
    eval 42
  TypeDef "Client" pub
    body { base: string }
    method "get" pub
      param path: string
      result string | error
      return <none>
  Func "fetch"
    param url: string
    result string | error
  Func "now"
    result datetime
  Func "pageTitle" pub
    param url: string
    result string | error
      return <none>
  Func "stamp" pub
    result datetime
      return now()
  Func "double" pub
    param x: int
    result int
      return ParamRef "x".mul(IntLiteral "2")
  Assert "double(2) == 4"
    eval true
      double(2) == 4
      ^         ^
      4         true
