Module
  Const "A"
    type int
    value double(IntLiteral "21")
    eval 42
  TypeDef "Client" pub
    body { base: string }
    method "get" pub
      effects io async
      param path: string
      result string | error
      return await fetch(self.base.add(ParamRef "path"))
  Func "fetch" extern
    effects io async
    param url: string
    result string | error
  Func "now" extern
    effects nondet
    result datetime
  Func "pageTitle" pub
    effects io async
    param url: string
    result string | error
      return await fetch(ParamRef "url")
  Func "stamp" pub
    effects nondet
    result datetime
      return now()
  Func "double" pub
    param x: int
    result int
      return ParamRef "x".mul(IntLiteral "2")
  Assert "double(2) == 4"
    eval true
      double(2) == 4
      ^         ^
      4         true
