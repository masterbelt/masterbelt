Module
  Const "Summed"
    type nint
    value (sum(([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint), (IntLiteral "4" : nint)] : list<nint>)) : nint)
    eval 10
  Const "Joined"
    type string
    value (keysJoined(([(StringLiteral "a" : string): (IntLiteral "1" : nint), (StringLiteral "b" : string): (IntLiteral "2" : nint), (StringLiteral "c" : string): (IntLiteral "3" : nint)] : map<string, nint>)) : string)
    eval "abc"
  Const "ValueSummed"
    type nint
    value (valueSum(([(StringLiteral "a" : string): (IntLiteral "1" : nint), (StringLiteral "b" : string): (IntLiteral "2" : nint), (StringLiteral "c" : string): (IntLiteral "3" : nint)] : map<string, nint>)) : nint)
    eval 6
  Const "IndexSummed"
    type nint
    value (indexSum(([(IntLiteral "10" : nint), (IntLiteral "20" : nint), (IntLiteral "30" : nint)] : list<nint>)) : nint)
    eval 3
  Const "EvenSum"
    type nint
    value (sumEven(([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint), (IntLiteral "4" : nint), (IntLiteral "5" : nint), (IntLiteral "6" : nint)] : list<nint>)) : nint)
    eval 12
  Const "Pairs"
    type nint
    value (pairCount(([(IntLiteral "1" : nint), (IntLiteral "2" : nint)] : list<nint>), ([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint)] : list<nint>)) : nint)
    eval 6
  Const "Product"
    type nint
    value (product(([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint), (IntLiteral "4" : nint)] : list<nint>)) : nint)
    eval 24
  Func "sum" pub
    param xs: list<nint>
    result nint
      let "total": nint = (IntLiteral "0" : nint)
      for x of nint (ParamRef "xs" : list<nint>)
          assign "total" = ((LocalRef "total" : nint).add((LocalRef "x" : nint)) : nint)
      return (LocalRef "total" : nint)
  Func "keysJoined" pub
    param m: map<string, nint>
    result string
      let "out": string = (StringLiteral "" : string)
      for k in string (ParamRef "m" : map<string, nint>)
          assign "out" = ((LocalRef "out" : string).add((LocalRef "k" : string)) : string)
      return (LocalRef "out" : string)
  Func "valueSum" pub
    param m: map<string, nint>
    result nint
      let "total": nint = (IntLiteral "0" : nint)
      for v of nint (ParamRef "m" : map<string, nint>)
          assign "total" = ((LocalRef "total" : nint).add((LocalRef "v" : nint)) : nint)
      return (LocalRef "total" : nint)
  Func "indexSum" pub
    param xs: list<nint>
    result nint
      let "total": nint = (IntLiteral "0" : nint)
      for i in nint (ParamRef "xs" : list<nint>)
          assign "total" = ((LocalRef "total" : nint).add((LocalRef "i" : nint)) : nint)
      return (LocalRef "total" : nint)
  Func "sumEven" pub
    param xs: list<nint>
    result nint
      let "total": nint = (IntLiteral "0" : nint)
      for x of nint (ParamRef "xs" : list<nint>)
          if (((LocalRef "x" : nint).rem((IntLiteral "2" : nint)) : nint).eql((IntLiteral "0" : nint)) : bool)
              assign "total" = ((LocalRef "total" : nint).add((LocalRef "x" : nint)) : nint)
      return (LocalRef "total" : nint)
  Func "pairCount" pub
    param xs: list<nint>
    param ys: list<nint>
    result nint
      let "count": nint = (IntLiteral "0" : nint)
      for x of nint (ParamRef "xs" : list<nint>)
          for y of nint (ParamRef "ys" : list<nint>)
              assign "count" = ((LocalRef "count" : nint).add((IntLiteral "1" : nint)) : nint)
      return (LocalRef "count" : nint)
  Func "product" pub
    param xs: list<nint>
    result nint
      let "acc": nint = (IntLiteral "1" : nint)
      for x of nint (ParamRef "xs" : list<nint>)
          assign "acc" = ((LocalRef "acc" : nint).mul((LocalRef "x" : nint)) : nint)
      return (LocalRef "acc" : nint)
  Assert "sum([1, 2, 3, 4]) == 10"
    eval true
      sum([1, 2, 3, 4]) == 10
      ^                 ^
      10                true
  Assert "keysJoined([\"a\": 1, \"b\": 2, \"c\": 3]) == \"abc\""
    eval true
      keysJoined(["a": 1, "b": 2, "c": 3]) == "abc"
      ^                                    ^
      "abc"                                true
  Assert "valueSum([\"a\": 1, \"b\": 2, \"c\": 3]) == 6"
    eval true
      valueSum(["a": 1, "b": 2, "c": 3]) == 6
      ^                                  ^
      6                                  true
  Assert "indexSum([10, 20, 30]) == 3"
    eval true
      indexSum([10, 20, 30]) == 3
      ^                      ^
      3                      true
  Assert "sumEven([1, 2, 3, 4, 5, 6]) == 12"
    eval true
      sumEven([1, 2, 3, 4, 5, 6]) == 12
      ^                           ^
      12                          true
  Assert "pairCount([1, 2], [1, 2, 3]) == 6"
    eval true
      pairCount([1, 2], [1, 2, 3]) == 6
      ^                            ^
      6                            true
  Assert "product([1, 2, 3, 4]) == 24"
    eval true
      product([1, 2, 3, 4]) == 24
      ^                     ^
      24                    true
  Assert "sum([]) == 0"
    eval true
      sum([]) == 0
      ^       ^
