  Func "product" pub
    param xs: list<int>
    result int
      let "acc": int = IntLiteral "1"
      return LocalRef "acc"
  Assert "sum([1, 2, 3, 4]) == 10"
    eval false
      sum([1, 2, 3, 4]) == 10
      ^                 ^
      0                 false
  Assert "keysJoined([\"a\": 1, \"b\": 2, \"c\": 3]) == \"abc\""
    eval false
      keysJoined(["a": 1, "b": 2, "c": 3]) == "abc"
      ^                                    ^
      ""                                   false
  Assert "valueSum([\"a\": 1, \"b\": 2, \"c\": 3]) == 6"
    eval false
      valueSum(["a": 1, "b": 2, "c": 3]) == 6
      ^                                  ^
      0                                  false
  Assert "indexSum([10, 20, 30]) == 3"
    eval false
      indexSum([10, 20, 30]) == 3
      ^                      ^
      0                      false
  Assert "sumEven([1, 2, 3, 4, 5, 6]) == 12"
    eval false
      sumEven([1, 2, 3, 4, 5, 6]) == 12
      ^                           ^
      0                           false
  Assert "pairCount([1, 2], [1, 2, 3]) == 6"
    eval false
      pairCount([1, 2], [1, 2, 3]) == 6
      ^                            ^
      0                            false
  Assert "product([1, 2, 3, 4]) == 24"
    eval false
      product([1, 2, 3, 4]) == 24
      ^                     ^
      1                     false
  Assert "sum([]) == 0"
    eval true
      sum([]) == 0
      ^       ^
      0       true
