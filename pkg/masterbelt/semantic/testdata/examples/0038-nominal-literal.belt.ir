Module
  Const "Hello"
    type Tag
    value StringLiteral "hello"
    eval "hello"
  Const "World"
    type string
    value StringLiteral "world"
    eval "world"
  Const "There"
    type Tag
    value Reference -> "World"
    eval "world"
  Const "Greeting"
    type Tag
    value Reference -> "Hello".add(StringLiteral " ").add(Reference -> "There")
    eval "hello world"
  Const "SameTag"
    type bool
    value Reference -> "Hello".eql(StringLiteral "hello")
    eval true
  Const "OtherTag"
    type bool
    value Reference -> "Hello".neq(Reference -> "There")
    eval true
  Const "North"
    type Direction
    value StringLiteral "north"
    eval "north"
  Const "South"
    type Direction
    value StringLiteral "south"
    eval "south"
  Const "Ok"
    type Labeled
    value StringLiteral "tagged"
    eval (Tag) "tagged"
  Const "FromOk"
    type Tag
    value label(StringLiteral "done")
    eval "done"
  TypeDef "Tag" pub
    body string
  TypeDef "Direction" pub
    body string
    where self == "north" || self == "south"
  TypeDef "Labeled" pub
    body Tag | error
  Func "label" pub
    param v: Labeled
    result Tag
      match ParamRef "v"
        arm Tag t
          return LocalRef "t"
        arm error e
          return StringLiteral "error"
  Assert "Hello == \"hello\""
    eval true
      Hello == "hello"
      ^     ^
      |     true
      "hello"
  Assert "Greeting == \"hello world\""
    eval true
      Greeting == "hello world"
      ^        ^
      |        true
      "hello world"
  Assert "SameTag"
    eval true
      SameTag
      ^
      true
  Assert "OtherTag"
    eval true
      OtherTag
      ^
      true
  Assert "North != South"
    eval true
      North != South
      ^     ^  ^
      |     |  "south"
      |     true
      "north"
  Assert "label(\"done\") == \"done\""
    eval true
      label("done") == "done"
      ^             ^
      "done"        true
