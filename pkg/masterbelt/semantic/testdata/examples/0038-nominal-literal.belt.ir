Module
  Const "Hello"
    type Tag
    value (StringLiteral "hello" : string)
    eval "hello"
  Const "World"
    type string
    value (StringLiteral "world" : string)
    eval "world"
  Const "There"
    type Tag
    value (Reference -> "World" : string)
    eval "world"
  Const "Greeting"
    type Tag
    value (((Reference -> "Hello" : Tag).add((StringLiteral " " : string)) : Tag).add((Reference -> "There" : Tag)) : Tag)
    eval "hello world"
  Const "SameTag"
    type bool
    value ((Reference -> "Hello" : Tag).eql((StringLiteral "hello" : string)) : bool)
    eval true
  Const "OtherTag"
    type bool
    value ((Reference -> "Hello" : Tag).neq((Reference -> "There" : Tag)) : bool)
    eval true
  Const "North"
    type Direction
    value (StringLiteral "north" : string)
    eval "north"
  Const "South"
    type Direction
    value (StringLiteral "south" : string)
    eval "south"
  Const "Ok"
    type Labeled
    value (StringLiteral "tagged" : string)
    eval (Tag) "tagged"
  Const "FromOk"
    type Tag
    value (label((StringLiteral "done" : string)) : Tag)
    eval "done"
  TypeDef "Tag" pub
    body string
  TypeDef "Direction" pub
    body string
    where self == "north" || self == "south"
  TypeDef "Labeled" pub
    body Tag | error
  Func "label" pub
    param v: Labeled
    result Tag
      match (ParamRef "v" : Labeled)
        arm Tag t
          return (LocalRef "t" : Tag)
        arm error e
          return (StringLiteral "error" : string)
  Assert "Hello == \"hello\""
    eval true
      Hello == "hello"
      ^     ^
      |     true
      "hello"
  Assert "Greeting == \"hello world\""
    eval true
      Greeting == "hello world"
      ^        ^
      |        true
      "hello world"
  Assert "SameTag"
    eval true
      SameTag
      ^
      true
  Assert "OtherTag"
    eval true
      OtherTag
      ^
      true
  Assert "North != South"
    eval true
      North != South
      ^     ^  ^
      |     |  "south"
      |     true
      "north"
  Assert "label(\"done\") == \"done\""
    eval true
      label("done") == "done"
      ^             ^
      "done"        true
