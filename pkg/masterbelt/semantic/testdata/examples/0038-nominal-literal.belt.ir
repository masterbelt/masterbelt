Module
  Const "Hello"
    type Tag
    value (adapt (StringLiteral "hello" : string) : Tag)
    eval "hello"
  Const "World"
    type string
    value (StringLiteral "world" : string)
    eval "world"
  Const "There"
    type Tag
    value (adapt (Reference -> "World" : string) : Tag)
    eval "world"
  Const "Greeting"
    type Tag
    value (((Reference -> "Hello" : Tag).add((adapt (StringLiteral " " : string) : Tag)) : Tag).add((Reference -> "There" : Tag)) : Tag)
    eval "hello world"
  Const "SameTag"
    type bool
    value ((Reference -> "Hello" : Tag).eql((adapt (StringLiteral "hello" : string) : Tag)) : bool)
    eval true
  Const "OtherTag"
    type bool
    value ((Reference -> "Hello" : Tag).neq((Reference -> "There" : Tag)) : bool)
    eval true
  Const "North"
    type Direction
    value (adapt (StringLiteral "north" : string) : Direction)
    eval "north"
  Const "South"
    type Direction
    value (adapt (StringLiteral "south" : string) : Direction)
    eval "south"
  Const "Ok"
    type Labeled
    value (adapt (adapt (StringLiteral "tagged" : string) : Tag) : Labeled)
    eval (Tag) "tagged"
  Const "FromOk"
    type Tag
    value (label((adapt (adapt (StringLiteral "done" : string) : Tag) : Labeled)) : Tag)
    eval "done"
  TypeDef "Tag" pub
    body string
  TypeDef "Direction" pub
    body string
    where (((self : Direction).eql((adapt (StringLiteral "north" : string) : Direction)) : bool).oror(((self : Direction).eql((adapt (StringLiteral "south" : string) : Direction)) : bool)) : bool)
  TypeDef "Labeled" pub
    body Tag | error
  Func "label" pub
    param v: Labeled
    result Tag
      match (ParamRef "v" : Labeled)
        arm Tag t
          return (LocalRef "t" : Tag)
        arm error e
          return (adapt (StringLiteral "error" : string) : Tag)
  Assert "Hello == \"hello\""
    eval true
      Hello == "hello"
      ^     ^
      |     true
      "hello"
  Assert "Greeting == \"hello world\""
    eval true
      Greeting == "hello world"
      ^        ^
      |        true
      "hello world"
  Assert "SameTag"
    eval true
      SameTag
      ^
      true
  Assert "OtherTag"
    eval true
      OtherTag
      ^
      true
  Assert "North != South"
    eval true
      North != South
      ^     ^  ^
      |     |  "south"
      |     true
      "north"
  Assert "label(\"done\") == \"done\""
    eval true
      label("done") == "done"
      ^             ^
      "done"        true
