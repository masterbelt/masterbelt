Module
  Const "Picked"
    type int
    value pick(BoolLiteral true)
  Const "Stepped"
    type int
    value step(IntLiteral "41")
  Func "pick" pub
    param flag: bool
    result int
      if ParamRef "flag"
      return <none>
  Func "step" pub
    param n: int
    result int
      return <none>
  Func "shadow" pub
    param flag: bool
    result int
      if ParamRef "flag"
          return <none>
      return <none>
  Assert "pick(false) == 10"
    eval <unevaluated>
      pick(false) == 10
  Assert "step(41) == 42"
    eval <unevaluated>
      step(41) == 42
