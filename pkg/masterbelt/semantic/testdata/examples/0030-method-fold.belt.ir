Module
  Const "FireIsFire"
    type bool
    value ((Element.Fire : Element).isFire() : bool)
    eval true
  Const "FireLabel"
    type nint
    value ((Element.Fire : Element).label() : nint)
    eval 1
  Const "WaterLabel"
    type nint
    value ((Element.Water : Element).label() : nint)
    eval 0
  Const "Six"
    type Level
    value (Level((IntLiteral "5" : nint)).increment() : Level)
    eval 6
  Const "Start"
    type Level
    value (adapt (IntLiteral "10" : nint) : Level)
    eval 10
  Const "Eleven"
    type Level
    value ((Reference -> "Start" : Level).increment() : Level)
    eval 11
  Const "Thirteen"
    type Level
    value ((Reference -> "Start" : Level).plus((adapt (IntLiteral "3" : nint) : sbyte)) : Level)
    eval 13
  Const "Three"
    type Level
    value (((base() : Level).increment() : Level).increment() : Level)
    eval 3
  Const "Hero"
    type Character
    value ({lv: Level((IntLiteral "5" : nint))} : Character)
    eval { lv: 5 }
  Const "Promoted"
    type Level
    value (((Reference -> "Hero" : Character).lv : Level).increment() : Level)
    eval 6
  Const "Squad"
    type Party
    value ({leader: ({lv: Level((IntLiteral "8" : nint))} : Character)} : Party)
    eval { leader: { lv: 8 } }
  Const "LeaderUp"
    type Level
    value ((((Reference -> "Squad" : Party).leader : Character).lv : Level).increment() : Level)
    eval 9
  TypeDef "Level" pub
    doc "A character level, with methods over its underlying sbyte."
    body sbyte
    method "increment" pub
      doc "The next level up — a self-returning method, so a chain keeps the type."
      result self
      return ((self : Level).add((adapt (IntLiteral "1" : nint) : Level)) : Level)
    method "plus" pub
      doc "This level a number of steps up. The base value lifts into the nominal"
      doc "type through the conversion: a Level derives sbyte's operators, but their"
      doc "self-typed operands stay nominal, so mixing in a bare sbyte is a type"
      doc "error — Level(steps) is the explicit lift."
      param steps: sbyte
      result self
      return ((self : Level).add(Level((ParamRef "steps" : sbyte))) : Level)
  TypeDef "Character" pub
    doc "A character with a level field."
    body { lv: Level }
  TypeDef "Party" pub
    doc "A party wrapping a character, to exercise a nested field path."
    body { leader: Character }
  TypeDef "Element" pub
    doc "An elemental affinity, with methods that fold over a constant member."
    enum nint
    member "Fire" = 0
    member "Water" = 1
    member "Wind" = 2
    impl comparable
    impl orderable
    method "eql" pub extern
      param other: self
      result bool
    method "neq" pub extern
      param other: self
      result bool
    method "lt" pub extern
      param other: self
      result bool
    method "lteq" pub extern
      param other: self
      result bool
    method "gt" pub extern
      param other: self
      result bool
    method "gteq" pub extern
      param other: self
      result bool
    method "isFire" pub
      doc "Whether this element is Fire — a one-line body that folds to a bool."
      result bool
      return ((self : Element).eql((Element.Fire : Element)) : bool)
    method "notFire" pub
      doc "Whether this element is not Fire — a method that calls another method."
      result bool
      return (((self : Element).isFire() : bool).not() : bool)
    method "label" pub
      doc "A let- and if-bearing body, to exercise the full statement walker."
      result nint
      let "fire": bool = ((self : Element).isFire() : bool)
      if (LocalRef "fire" : bool)
          return (IntLiteral "1" : nint)
      return (IntLiteral "0" : nint)
  Func "base" pub
    doc "A function whose declared result type names Level — the chain channel."
    result Level
      return Level((IntLiteral "1" : nint))
  Assert "Element.Fire.isFire()"
    eval true
      Element.Fire.isFire()
              ^    ^
              |    true
              Element.Fire
  Assert "Element.Water.notFire()"
    eval true
      Element.Water.notFire()
              ^     ^
              |     true
              Element.Water
  Assert "Element.Fire.label() == 1"
    eval true
      Element.Fire.label() == 1
              ^    ^       ^
              |    1       true
              Element.Fire
  Assert "Element.Wind.label() == 0"
    eval true
      Element.Wind.label() == 0
              ^    ^       ^
              |    0       true
              Element.Wind
  Assert "Start.increment() == 11"
    eval true
      Start.increment() == 11
      ^     ^           ^
      10    11          true
  Assert "base().plus(4) == 5"
    eval true
      base().plus(4) == 5
      ^      ^       ^
      1      5       true
  Assert "Hero.lv.increment() == 6"
    eval true
      Hero.lv.increment() == 6
      ^    ^  ^           ^
      |    5  6           true
      { lv: 5 }
  Assert "Squad.leader.lv.increment().increment() == 10"
    eval true
      Squad.leader.lv.increment().increment() == 10
      ^     ^      ^  ^           ^           ^
      |     |      8  9           10          true
      |     { lv: 8 }
      { leader: { lv: 8 } }
