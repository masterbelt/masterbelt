Module
  TypeDef "Bag" pub
    doc "A small bag of T values that folds over its contents. The `impl foldable<int, T>`"
    doc "tag is what gives Bag the count/any methods — written here, at Bag's own"
    doc "definition site."
    param "T"
    body list<T>
    method "fold"
      doc "The required primitive: fold the underlying list."
      param init: A
      param step: fn(A, int, T): A
      result A
      return ParamRef "init"
  Func "total" pub
    doc "The total of a collection of ints, folded with addition."
    param c: invalid
    result int
      return ParamRef "c".fold(IntLiteral "0", (fn(acc, key, value) (return ParamRef "acc".add(ParamRef "value"))))
