Module
  TypeDef "Bag" pub
    doc "A small bag of T values that folds over its contents. The `impl foldable<nint, T>`"
    doc "tag is what gives Bag the count/any methods — written here, at Bag's own"
    doc "definition site."
    param "T"
    impl foldable<nint, T>
    body list<T>
    method "fold"
      doc "The required primitive: fold the underlying list."
      param init: A
      param step: fn(A, nint, T): A
      result A
      return (ParamRef "init" : A)
  TypeDef "foldable" pub
    doc "A behaviour over a keyed collection: implement the required fold and the"
    doc "provided methods (count, map, filter, ...) come for free, defined on top of"
    doc "it. iterability is foldable."
    param "K"
    param "V"
    interface
    required "fold"
    provided "count"
    provided "any"
    method "fold"
      param init: A
      param step: fn(A, K, V): A
      result A
    method "count" pub
      doc "Provided: the number of elements, folded from the primitive."
      result nint
      return ((self : foldable).fold((IntLiteral "0" : nint), ((fn(acc, key, value) (return ((ParamRef "acc" : nint).add((IntLiteral "1" : nint)) : nint))) : fn(nint, K, V): nint)) : nint) [subst A=nint]
    method "any" pub
      doc "Provided: whether any element satisfies the predicate."
      param pred: fn(V): bool
      result bool
      return ((self : foldable).fold((BoolLiteral false : bool), ((fn(acc, key, value) (return ((ParamRef "acc" : bool).oror(<none>) : bool))) : fn(bool, K, V): bool)) : bool) [subst A=bool]
  Func "total" pub
    doc "The total of a collection of ints, folded with addition."
    param c: foldable<nint, nint>
    result nint
      return ((ParamRef "c" : foldable<nint, nint>).fold((IntLiteral "0" : nint), ((fn(acc, key, value) (return ((ParamRef "acc" : nint).add((ParamRef "value" : nint)) : nint))) : fn(nint, nint, nint): nint)) : nint) [subst A=nint, K=nint, V=nint]
