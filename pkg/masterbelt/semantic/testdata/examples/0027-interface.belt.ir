Module
  TypeDef "Bag" pub
    doc "A small bag of T values that folds over its contents. The `impl foldable<int, T>`"
    doc "tag is what gives Bag the count/any methods — written here, at Bag's own"
    doc "definition site."
    param "T"
    impl foldable<int, T>
    body list<T>
    method "fold"
      doc "The required primitive: fold the underlying list."
      param init: A
      param step: fn(A, int, T): A
      result A
      return ParamRef "init"
  TypeDef "foldable" pub
    doc "A behaviour over a keyed collection: implement the required fold and the"
    doc "provided methods (count, map, filter, ...) come for free, defined on top of"
    doc "it. iterability is foldable."
    param "K"
    param "V"
    interface
    required "fold"
    provided "count"
    provided "any"
    method "fold"
      param init: A
      param step: fn(A, K, V): A
      result A
    method "count" pub
      doc "Provided: the number of elements, folded from the primitive."
      result int
      return self.fold(IntLiteral "0", (fn(acc, key, value) (return ParamRef "acc".add(IntLiteral "1"))))
    method "any" pub
      doc "Provided: whether any element satisfies the predicate."
      param pred: fn(V): bool
      result bool
      return self.fold(BoolLiteral false, (fn(acc, key, value) (return ParamRef "acc".oror(<none>))))
  Func "total" pub
    doc "The total of a collection of ints, folded with addition."
    param c: foldable<int, int>
    result int
      return ParamRef "c".fold(IntLiteral "0", (fn(acc, key, value) (return ParamRef "acc".add(ParamRef "value"))))
