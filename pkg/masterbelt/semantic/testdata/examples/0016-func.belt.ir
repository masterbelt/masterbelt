Module
  Const "A"
    type nint
    value area(IntLiteral "3", IntLiteral "4")
    eval 12
  Const "B"
    type nint
    value double(IntLiteral "21")
    eval 42
  Const "C"
    type nint
    value perimeter(IntLiteral "2", IntLiteral "3")
    eval 10
  Const "D"
    type list<nint>
    value [IntLiteral "1", IntLiteral "2", IntLiteral "3"].map((fn(x) (return double(ParamRef "x")))) [subst K=nint, R=nint, T=nint, V=nint]
    eval [2, 4, 6]
  Const "E"
    type string
    value greet(StringLiteral "belt")
    eval "Hello, belt"
  Const "O"
    type Point
    value origin()
    eval { x: 0, y: 0 }
  TypeDef "Point" pub
    body { x: nint, y: nint }
  Func "double" pub
    param x: nint
    result nint
      return ParamRef "x".mul(IntLiteral "2")
  Func "area" pub
    param w: nint
    param h: nint
    result nint
      return ParamRef "w".mul(ParamRef "h")
  Func "perimeter" pub
    param w: nint
    param h: nint
    result nint
      return double(ParamRef "w").add(double(ParamRef "h"))
  Func "greet"
    param name: string
    result string
      return StringLiteral "Hello, ".add(ParamRef "name")
  Func "origin" pub
    result Point
      return Point{x: IntLiteral "0", y: IntLiteral "0"}
  Assert "area(3, 4) == 12"
    eval true
      area(3, 4) == 12
      ^          ^
      12         true
