Module
  Const "MaxLevel"
    type nint
    value (IntLiteral "100" : nint)
    eval 100
  Const "MinLevel"
    type nint
    value (IntLiteral "0" : nint)
    eval 0
  Const "Enabled"
    type bool
    value (BoolLiteral true : bool)
    eval true
  Assert "MaxLevel > MinLevel"
    doc "The level range is not empty."
    eval true
      MaxLevel > MinLevel
      ^        ^ ^
      100      | 0
               true
  Assert "MinLevel == 0"
    eval true
      MinLevel == 0
      ^        ^
      0        true
  Assert "MaxLevel - MinLevel == 100"
    eval true
      MaxLevel - MinLevel == 100
      ^        ^ ^        ^
      100      | 0        true
               100
  Assert "Enabled && !false"
    eval true
      Enabled && !false
      ^       ^  ^
      true    |  true
              true
  Assert "MaxLevel > 0 && !(MinLevel > 0)"
    eval true
      MaxLevel > 0 && !(MinLevel > 0)
      ^        ^   ^  ^ ^        ^
      100      |   |  | 0        false
               |   |  true
               |   true
               true
