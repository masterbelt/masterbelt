  Func "total" pub
    result nint
      let "t": nint = (IntLiteral "0" : nint)
      for i of nint range((IntLiteral "0" : nint), (IntLiteral "10" : nint))
          assign "t" = ((LocalRef "t" : nint).add((LocalRef "i" : nint)) : nint)
      return (LocalRef "t" : nint)
  Func "positionSum" pub
    result nint
      let "t": nint = (IntLiteral "0" : nint)
      for i in nint range((IntLiteral "5" : nint), (IntLiteral "10" : nint))
