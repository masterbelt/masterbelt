  Func "emptySum" pub
    result nint
      let "t": nint = (IntLiteral "100" : nint)
      for i of nint range((IntLiteral "10" : nint), (IntLiteral "9" : nint))
          assign "t" = ((LocalRef "t" : nint).add((LocalRef "i" : nint)) : nint)
      return (LocalRef "t" : nint)
