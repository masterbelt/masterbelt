Module
  Const "Sum"
    type nint
    value total()
    eval 55
  Const "PositionSum"
    type nint
    value positionSum()
    eval 15
  Const "EmptySum"
    type nint
    value emptySum()
    eval 100
  Const "Count"
    type nint
    value range(IntLiteral "0", IntLiteral "10").count() [subst K=nint, V=nint]
    eval 11
  Const "EmptyCount"
    type nint
    value range(IntLiteral "5", IntLiteral "4").count() [subst K=nint, V=nint]
    eval 0
  Const "AnyBig"
    type bool
    value range(IntLiteral "0", IntLiteral "10").any((fn(v) (return ParamRef "v".gt(IntLiteral "8")))) [subst K=nint, V=nint]
    eval true
  Const "AllNonNeg"
    type bool
    value range(IntLiteral "0", IntLiteral "10").all((fn(v) (return ParamRef "v".gteq(IntLiteral "0")))) [subst K=nint, V=nint]
    eval true
  Const "Doubled"
    type list<nint>
    value range(IntLiteral "0", IntLiteral "5").map((fn(v) (return ParamRef "v".mul(IntLiteral "2")))) [subst K=nint, U=nint, V=nint]
    eval [0, 2, 4, 6, 8, 10]
  Const "Evens"
    type list<nint>
    value range(IntLiteral "0", IntLiteral "10").filter((fn(v) (return ParamRef "v".rem(IntLiteral "2").eql(IntLiteral "0")))) [subst K=nint, V=nint]
    eval [0, 2, 4, 6, 8, 10]
  Const "Values"
    type list<nint>
    value range(IntLiteral "3", IntLiteral "7").values() [subst K=nint, V=nint]
    eval [3, 4, 5, 6, 7]
  Const "Keys"
    type list<nint>
    value range(IntLiteral "3", IntLiteral "7").keys() [subst K=nint, V=nint]
    eval [0, 1, 2, 3, 4]
  Const "Folded"
    type nint
    value range(IntLiteral "0", IntLiteral "4").fold(IntLiteral "0", (fn(acc, k, v) (return ParamRef "acc".add(ParamRef "v")))) [subst A=nint, K=nint, V=nint]
    eval 10
  Func "total" pub
    result nint
      let "t": nint = IntLiteral "0"
      for i of nint range(IntLiteral "0", IntLiteral "10")
          assign "t" = LocalRef "t".add(LocalRef "i")
      return LocalRef "t"
  Func "positionSum" pub
    result nint
      let "t": nint = IntLiteral "0"
      for i in nint range(IntLiteral "5", IntLiteral "10")
          assign "t" = LocalRef "t".add(LocalRef "i")
      return LocalRef "t"
  Func "emptySum" pub
    result nint
      let "t": nint = IntLiteral "100"
      for i of nint range(IntLiteral "10", IntLiteral "9")
          assign "t" = LocalRef "t".add(LocalRef "i")
      return LocalRef "t"
  Assert "total() == 55"
    eval true
      total() == 55
      ^       ^
      55      true
  Assert "positionSum() == 15"
    eval true
      positionSum() == 15
      ^             ^
      15            true
  Assert "emptySum() == 100"
    eval true
      emptySum() == 100
      ^          ^
      100        true
  Assert "range(0, 10).count() == 11"
    eval true
      range(0, 10).count() == 11
      ^            ^       ^
      range(0, 10) 11      true
  Assert "range(5, 4).count() == 0"
    eval true
      range(5, 4).count() == 0
      ^           ^       ^
      range(5, 4) 0       true
  Assert "range(0, 10).any(fn(v: nint): bool { return v > 8 })"
    eval true
      range(0, 10).any(fn(v: nint): bool { return v > 8 })
      ^            ^
      range(0, 10) true
  Assert "range(0, 10).all(fn(v: nint): bool { return v >= 0 })"
    eval true
      range(0, 10).all(fn(v: nint): bool { return v >= 0 })
      ^            ^
      range(0, 10) true
  Assert "range(0, 5).map(fn(v: nint): nint { return v * 2 }).len() == 6"
    eval true
      range(0, 5).map(fn(v: nint): nint { return v * 2 }).len() == 6
      ^           ^                                       ^     ^
      range(0, 5) [0, 2, 4, 6, 8, 10]                     6     true
  Assert "range(0, 5).map(fn(v: nint): nint { return v * 2 }).fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 30"
    eval true
      range(0, 5).map(fn(v: nint): nint { return v * 2 }).fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 30
      ^           ^                                       ^                                                                 ^
      range(0, 5) [0, 2, 4, 6, 8, 10]                     30                                                                true
  Assert "range(0, 10).filter(fn(v: nint): bool { return v % 2 == 0 }).len() == 6"
    eval true
      range(0, 10).filter(fn(v: nint): bool { return v % 2 == 0 }).len() == 6
      ^            ^                                               ^     ^
      range(0, 10) [0, 2, 4, 6, 8, 10]                             6     true
  Assert "range(3, 7).values().len() == 5"
    eval true
      range(3, 7).values().len() == 5
      ^           ^        ^     ^
      range(3, 7) |        5     true
                  [3, 4, 5, 6, 7]
  Assert "range(3, 7).values().fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 25"
    eval true
      range(3, 7).values().fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 25
      ^           ^        ^                                                                 ^
      range(3, 7) |        25                                                                true
                  [3, 4, 5, 6, 7]
  Assert "range(3, 7).keys().fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 10"
    eval true
      range(3, 7).keys().fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 10
      ^           ^      ^                                                                 ^
      range(3, 7) |      10                                                                true
                  [0, 1, 2, 3, 4]
  Assert "range(0, 4).fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 10"
    eval true
      range(0, 4).fold(0, fn(acc: nint, k: nint, v: nint): nint { return acc + v }) == 10
      ^           ^                                                                 ^
      range(0, 4) 10                                                                true
