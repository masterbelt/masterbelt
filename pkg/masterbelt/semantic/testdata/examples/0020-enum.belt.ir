Module
  Const "Top"
    type invalid
    value <none>
  Const "Bare"
    type invalid
    value <none>
  Assert "Rarity.Common != Rarity.Legend"
    eval <unevaluated>
      Rarity.Common != Rarity.Legend
  Assert "Rarity.Common < Rarity.Legend"
    eval <unevaluated>
      Rarity.Common < Rarity.Legend
  Assert "Rarity.Legend == Top"
    eval <unevaluated>
      Rarity.Legend == Top
  Assert "Bare == Rarity.Common"
    eval <unevaluated>
      Bare == Rarity.Common
  Assert "Locale.Ja < Locale.En"
    eval <unevaluated>
      Locale.Ja < Locale.En
