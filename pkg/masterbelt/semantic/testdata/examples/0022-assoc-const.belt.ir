Module
  Const "Hi"
    type nint
    value (sbyte.Max : nint)
    eval 127
  Const "Lo"
    type nint
    value (sbyte.Min : nint)
    eval -128
  Const "Top"
    type Level
    value (adapt (Level.Max : nint) : Level)
    eval 100
  Const "Bottom"
    type Level
    value (adapt (Level.Min : nint) : Level)
    eval 0
  Const "W"
    type int
    value (Bits.Width : int)
    eval 32
  Const "ServerPort"
    type Port
    value (adapt (IntLiteral "8080" : nint) : Port)
    eval 8080
  TypeDef "Level" pub
    doc "A character level, capped at 100."
    body sbyte
    const "Max" pub
      doc "The highest level."
      type nint
      value 100
    const "Min" pub
      doc "The lowest level."
      type nint
      value 0
    method "increment" pub
      doc "The next level."
      result self
      return ((self : Level).add((adapt (IntLiteral "1" : nint) : Level)) : Level)
  TypeDef "Bits" pub
    body int
    const "Width" pub
      doc "The width in bits."
      type int
      value 32
  TypeDef "Port" pub
    body int
    where (((self : Port).gteq((adapt (IntLiteral "1" : nint) : Port)) : bool).anan(((self : Port).lteq((adapt (short.Max : nint) : Port)) : bool)) : bool)
