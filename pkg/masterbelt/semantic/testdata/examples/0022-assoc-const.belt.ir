Module
  Const "Hi"
    type nint
    value sbyte.Max
    eval 127
  Const "Lo"
    type nint
    value sbyte.Min
    eval -128
  Const "Top"
    type Level
    value Level.Max
    eval 100
  Const "Bottom"
    type Level
    value Level.Min
    eval 0
  Const "W"
    type int
    value Bits.Width
    eval 32
  Const "ServerPort"
    type Port
    value IntLiteral "8080"
    eval 8080
  TypeDef "Level" pub
    doc "A character level, capped at 100."
    body sbyte
    const "Max" pub
      doc "The highest level."
      type nint
      value 100
    const "Min" pub
      doc "The lowest level."
      type nint
      value 0
    method "increment" pub
      doc "The next level."
      result self
      return self.add(IntLiteral "1")
  TypeDef "Bits" pub
    body int
    const "Width" pub
      doc "The width in bits."
      type int
      value 32
  TypeDef "Port" pub
    body int
    where self >= 1 && self <= short.Max
