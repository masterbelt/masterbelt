Module
  TypeDef "Rarity" pub
    doc "A card's rarity tier."
    enum int
    member "Common" = 0
    member "Rare" = 1
    member "Legend" = 2
    method "eql" pub extern
      param other: self
      result bool
    method "neq" pub extern
      param other: self
      result bool
    method "lt" pub extern
      param other: self
      result bool
    method "lteq" pub extern
      param other: self
      result bool
    method "gt" pub extern
      param other: self
      result bool
    method "gteq" pub extern
      param other: self
      result bool
  Func "color" pub
    param r: Rarity
    result string
      expr <none>
      expr r{Common: <none>, Rare: <none>, Legend: <none>}
  Func "grade" pub
    param n: int
    result string
      expr <none>
      expr n{_: <none>}
