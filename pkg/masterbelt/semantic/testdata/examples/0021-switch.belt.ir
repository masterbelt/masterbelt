Module
  TypeDef "Rarity" pub
    doc "A card's rarity tier."
    enum nint
    member "Common" = 0
    member "Rare" = 1
    member "Legend" = 2
    impl comparable
    impl orderable
    method "eql" pub extern
      param other: self
      result bool
    method "neq" pub extern
      param other: self
      result bool
    method "lt" pub extern
      param other: self
      result bool
    method "lteq" pub extern
      param other: self
      result bool
    method "gt" pub extern
      param other: self
      result bool
    method "gteq" pub extern
      param other: self
      result bool
  Func "color" pub
    param r: Rarity
    result string
      switch (ParamRef "r" : Rarity)
        arm (Rarity.Common : Rarity)
          return (StringLiteral "white" : string)
        arm (Rarity.Rare : Rarity)
          return (StringLiteral "blue" : string)
        arm (Rarity.Legend : Rarity)
          return (StringLiteral "gold" : string)
  Func "grade" pub
    param n: nint
    result string
      switch (ParamRef "n" : nint)
        arm (IntLiteral "0" : nint)
          return (StringLiteral "zero" : string)
        arm (IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint)
          return (StringLiteral "low" : string)
        else
          return (StringLiteral "high" : string)
