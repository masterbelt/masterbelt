Module
  TypeDef "Coin" pub
    doc "A coin denomination."
    body int8
  TypeDef "Level" pub
    doc "A character level."
    body int8
    method "increment" pub
      doc "The next level up."
      result self
      return self.add(IntLiteral "1")
  TypeDef "GameValue" pub
    doc "Any value the game can score: a Coin or a Level."
    body Coin | Level
  TypeDef "Optional" pub
    doc "A T, or nothing."
    param "T"
    body T | null
  TypeDef "OptionalNumeric" pub
    doc "A small integer, or nothing."
    param "T": int8 | int16
    body T | null
  TypeDef "Record" pub
    doc "One saved character: an id and its level."
    body { id: int8, level: Level }
    method "game_id" pub
      doc "The record's id widened into the game's id space."
      result int32
      return int32(self.id).mul(IntLiteral "1000")
  TypeDef "Mapper" pub
    doc "A mapping from T to R."
    param "T"
    param "R"
    body fn(T): R
