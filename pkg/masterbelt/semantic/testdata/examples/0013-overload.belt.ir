  TypeDef "Score" pub
    doc "A game score in points."
    body int
    method "merge" pub
      doc "The score with points merged in."
      param points: self
      result self
      return self.add(ParamRef "points")
    method "merge" pub
      doc "Whether an active run with this score counts."
      param active: bool
      result bool
      return ParamRef "active".anan(self.gt(IntLiteral "0"))
  TypeDef "Level" pub
    doc "A character level."
    body sbyte
    method "next" pub
      doc "The next level."
      result self
      return self.add(IntLiteral "1")
    method "next" pub
      doc "The level a number of steps up."
      param steps: self
      result self
      return self.add(ParamRef "steps")
