Module
  Const "Freezing"
    type invalid
    value <none>.freezing()
  Const "FreezingF"
    type invalid
    value Reference -> "Freezing".fahrenheit
  Const "FromBoiling"
    type invalid
    value <none>.fromF(IntLiteral "212")
  Const "Roundtrip"
    type invalid
    value <none>.fromF(<none>.freezing())
  Const "Full"
    type invalid
    value <none>.full()
  Const "Default"
    type invalid
    value <none>.base()
  TypeDef "Celsius" pub
    body { deg: nint }
    method "static" pub
      doc "The freezing point of water."
      result invalid
    method "freezing"
      result Celsius
      return Celsius{deg: IntLiteral "0"}
    method "fromF"
      param v: nint
      result Celsius
      return Celsius{deg: ParamRef "v".sub(IntLiteral "32").mul(IntLiteral "5").div(IntLiteral "9")}
    method "fromF"
      param c: Celsius
      result Celsius
      return ParamRef "c"
    method "get" pub
      doc "Fahrenheit reading: c.fahrenheit."
      result invalid
    method "fahrenheit"
      result nint
      return self.deg.mul(IntLiteral "9").div(IntLiteral "5").add(IntLiteral "32")
    method "set" pub
      doc "Fahrenheit write: c.fahrenheit = 212 (c is a let local)."
      result invalid
    method "fahrenheit"
      param v: nint
      result self
      return Celsius{deg: ParamRef "v".sub(IntLiteral "32").mul(IntLiteral "5").div(IntLiteral "9")}
  TypeDef "Health" pub
    body nint
    const "Max" pub
      doc "The maximum health."
      type nint
      value 100
    method "static" pub
      doc "A full health bar."
      result invalid
    method "full"
      result Health
      return Health.Max
    method "get" pub
      doc "The health expressed in tens (the band a UI shows)."
      result invalid
    method "band"
      result nint
      return self.div(IntLiteral "10")
  TypeDef "Element" pub
    enum nint
    member "Fire" = 0
    member "Water" = 1
    member "Wind" = 2
    impl comparable
    impl orderable
    method "eql" pub extern
      param other: self
      result bool
    method "neq" pub extern
      param other: self
      result bool
    method "lt" pub extern
      param other: self
      result bool
    method "lteq" pub extern
      param other: self
      result bool
    method "gt" pub extern
      param other: self
      result bool
    method "gteq" pub extern
      param other: self
      result bool
    method "get" pub
      doc "Whether this element is Fire."
      result invalid
    method "hot"
      result bool
      return self.eql(Element.Fire)
    method "static" pub
      doc "The default element."
      result invalid
    method "base"
      result Element
      return Element.Fire
  Func "boiling"
    result Celsius
      let "c": invalid = <none>.freezing()
      assign "" = IntLiteral "212"
      return LocalRef "c"
  Assert "FreezingF == 32"
    eval <unevaluated>
      FreezingF == 32
  Assert "FromBoiling.deg == 100"
    eval <unevaluated>
      FromBoiling.deg == 100
  Assert "Roundtrip.deg == 0"
    eval <unevaluated>
      Roundtrip.deg == 0
  Assert "boiling().deg == 100"
    eval <unevaluated>
      boiling().deg == 100
  Assert "Full.band == 10"
    eval <unevaluated>
      Full.band == 10
  Assert "Health.Max == 100"
    eval true
      Health.Max == 100
             ^   ^
             100 true
  Assert "Default.hot"
    eval <unevaluated>
      Default.hot
  Assert "!Element.Water.hot"
    eval <unevaluated>
      !Element.Water.hot
               ^
               Element.Water
