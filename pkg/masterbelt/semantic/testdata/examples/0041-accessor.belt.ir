Module
  Const "Freezing"
    type Celsius
    value (Celsius.freezing() : Celsius)
    eval { deg: 0 }
  Const "FreezingF"
    type nint
    value (Reference -> "Freezing".fahrenheit : nint)
    eval 32
  Const "FromBoiling"
    type Celsius
    value (Celsius.fromF((IntLiteral "212" : nint)) : Celsius) [resolved fromF(v: nint): Celsius]
    eval { deg: 100 }
  Const "Roundtrip"
    type Celsius
    value (Celsius.fromF((Celsius.freezing() : Celsius)) : Celsius) [resolved fromF(c: Celsius): Celsius]
    eval { deg: 0 }
  Const "Full"
    type Health
    value (Health.full() : Health)
    eval 100
  Const "Default"
    type Element
    value (Element.base() : Element)
    eval Element.Fire
  TypeDef "Celsius" pub
    body { deg: nint }
    method "freezing" pub static
      doc "The freezing point of water."
      result Celsius
      return (Celsius{deg: (IntLiteral "0" : nint)} : Celsius)
    method "fromF" pub static
      doc "A degree reading converted from a fahrenheit value."
      param v: nint
      result Celsius
      return (Celsius{deg: ((((ParamRef "v" : nint).sub((IntLiteral "32" : nint)) : nint).mul((IntLiteral "5" : nint)) : nint).div((IntLiteral "9" : nint)) : nint)} : Celsius)
    method "fromF" pub static
      doc "A degree reading converted from a celsius value (the static overload:"
      doc "same name, a Celsius argument rather than a nint)."
      param c: Celsius
      result Celsius
      return (ParamRef "c" : Celsius)
    method "fahrenheit" pub getter
      doc "Fahrenheit reading: c.fahrenheit."
      result nint
      return (((((self : Celsius).deg : nint).mul((IntLiteral "9" : nint)) : nint).div((IntLiteral "5" : nint)) : nint).add((IntLiteral "32" : nint)) : nint)
    method "fahrenheit" pub setter
      doc "Fahrenheit write: c.fahrenheit = 212 (c is a let local)."
      param v: nint
      result self
      return (Celsius{deg: ((((ParamRef "v" : nint).sub((IntLiteral "32" : nint)) : nint).mul((IntLiteral "5" : nint)) : nint).div((IntLiteral "9" : nint)) : nint)} : Celsius)
  TypeDef "Health" pub
    body nint
    const "Max" pub
      doc "The maximum health."
      type nint
      value 100
    method "full" pub static
      doc "A full health bar."
      result Health
      return (adapt (Health.Max : nint) : Health)
    method "band" pub getter
      doc "The health expressed in tens (the band a UI shows)."
      result nint
      return (nint((self : Health)).div((IntLiteral "10" : nint)) : nint)
  TypeDef "Element" pub
    enum nint
    member "Fire" = 0
    member "Water" = 1
    member "Wind" = 2
    impl comparable
    impl orderable
    method "eql" pub extern
      param other: self
      result bool
    method "neq" pub extern
      param other: self
      result bool
    method "lt" pub extern
      param other: self
      result bool
    method "lteq" pub extern
      param other: self
      result bool
    method "gt" pub extern
      param other: self
      result bool
    method "gteq" pub extern
      param other: self
      result bool
    method "hot" pub getter
      doc "Whether this element is Fire."
      result bool
      return ((self : Element).eql((Element.Fire : Element)) : bool)
    method "base" pub static
      doc "The default element."
      result Element
      return (Element.Fire : Element)
  Func "boiling"
    result Celsius
      let "c": Celsius = (Celsius.freezing() : Celsius)
      assign "c" = ((LocalRef "c" : Celsius).fahrenheit = (IntLiteral "212" : nint) : Celsius)
      return (LocalRef "c" : Celsius)
  Assert "FreezingF == 32"
    eval true
      FreezingF == 32
      ^         ^
      32        true
  Assert "FromBoiling.deg == 100"
    eval true
      FromBoiling.deg == 100
      ^           ^   ^
      |           100 true
      { deg: 100 }
  Assert "Roundtrip.deg == 0"
    eval true
      Roundtrip.deg == 0
      ^         ^   ^
      |         0   true
      { deg: 0 }
  Assert "boiling().deg == 100"
    eval true
      boiling().deg == 100
      ^         ^   ^
      |         100 true
      { deg: 100 }
  Assert "Full.band == 10"
    eval true
      Full.band == 10
      ^    ^    ^
      100  10   true
  Assert "Health.Max == 100"
    eval true
      Health.Max == 100
             ^   ^
             100 true
  Assert "Default.hot"
    eval true
      Default.hot
      ^       ^
      |       true
      Element.Fire
  Assert "!Element.Water.hot"
    eval true
      !Element.Water.hot
      ^        ^     ^
      true     |     false
               Element.Water
