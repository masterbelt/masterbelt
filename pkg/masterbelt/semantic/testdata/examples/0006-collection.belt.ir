Module
  Const "ExampleList"
    type list<nint>
    value ([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint)] : list<nint>)
    eval [1, 2, 3]
  Const "ExampleMap"
    type map<string, nint>
    value ([(StringLiteral "key" : string): (IntLiteral "100" : nint)] : map<string, nint>)
    eval ["key": 100]
  Const "Inferred"
    type list<nint>
    value ([(IntLiteral "10" : nint), (IntLiteral "20" : nint), (IntLiteral "30" : nint)] : list<nint>)
    eval [10, 20, 30]
  Const "Bytes"
    type list<sbyte>
    value ([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint)] : list<sbyte>)
