# geometry.belt
Module
  Const "Origin" pub
    doc "The zero point every path starts from."
    type nint
    value IntLiteral "0"
    eval 0
  Const "hidden"
    type nint
    value IntLiteral "1"
    eval 1
  TypeDef "Point" pub
    doc "A 1-D coordinate."
    body int
# main.belt
Module
  Const "start"
    type Point
    value Reference -> "Origin"
    eval 0
