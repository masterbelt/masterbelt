Module
  Const "Epoch"
    type invalid
    value <none>
  Const "Release"
    type invalid
    value <none>
  Const "Launch"
    type invalid
    value <none>
  Const "Cooldown"
    type invalid
    value <none>
  Const "Complex"
    type invalid
    value <none>
  Const "Deadline"
