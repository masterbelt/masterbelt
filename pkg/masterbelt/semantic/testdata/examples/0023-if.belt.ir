Module
  Func "clamp" pub
    param x: int
    param lo: int
    param hi: int
    result int
      expr ParamRef "x".lt(lo{lo: <none>})
      expr ParamRef "x".gt(hi{hi: <none>})
      return ParamRef "x"
  Func "warn" pub
    param n: int
    result int
      expr ParamRef "n".gt(IntLiteral "100")
      expr {}
      return ParamRef "n"
  Func "sign" pub
    param n: int
    result string
      expr ParamRef "n".gt(IntLiteral "0")
      expr {}
      expr {n: <none>}
      return StringLiteral "zero"
