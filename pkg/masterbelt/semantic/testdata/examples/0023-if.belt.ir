Module
  Func "clamp" pub
    param x: nint
    param lo: nint
    param hi: nint
    result nint
      if ((ParamRef "x" : nint).lt((ParamRef "lo" : nint)) : bool)
          return (ParamRef "lo" : nint)
      else if ((ParamRef "x" : nint).gt((ParamRef "hi" : nint)) : bool)
          return (ParamRef "hi" : nint)
      return (ParamRef "x" : nint)
  Func "warn" pub
    param n: nint
    result nint
      if ((ParamRef "n" : nint).gt((IntLiteral "100" : nint)) : bool)
          return (IntLiteral "0" : nint)
      return (ParamRef "n" : nint)
  Func "sign" pub
    param n: nint
    result string
      if ((ParamRef "n" : nint).gt((IntLiteral "0" : nint)) : bool)
          return (StringLiteral "positive" : string)
      else
          if ((ParamRef "n" : nint).lt((IntLiteral "0" : nint)) : bool)
