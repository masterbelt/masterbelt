Module
  Const "N"
    type nint
    value identity(IntLiteral "42") [subst T=nint]
    eval 42
  Const "P"
    type nint
    value firstOf(IntLiteral "7", IntLiteral "9") [subst T=nint]
    eval 7
  TypeDef "Bag" pub
    doc "A small bag of ints that folds over its contents — an opt-in implementor of"
    doc "foldable, so it satisfies a `T: foldable<nint, nint>` bound."
    impl foldable<nint, nint>
    body list<nint>
    method "fold"
      param init: A
      param step: fn(A, nint, nint): A
      result A
      return ParamRef "init"
  TypeDef "foldable" pub
    doc "A behaviour over a keyed collection: the required fold, plus the provided"
    doc "count derived from it. The same prelude-style interface a bound refers to."
    param "K"
    param "V"
    interface
    required "fold"
    provided "count"
    method "fold"
      param init: A
      param step: fn(A, K, V): A
      result A
    method "count" pub
      doc "Provided: the number of elements, folded from the primitive."
      result nint
      return self.fold(IntLiteral "0", (fn(acc, key, value) (return ParamRef "acc".add(IntLiteral "1"))))
  Func "total" pub
    doc "The total of any foldable collection of ints, folded with addition."
    typeparam "T": foldable<nint, nint>
    param c: T
    result nint
      return ParamRef "c".fold(IntLiteral "0", (fn(acc, key, value) (return ParamRef "acc".add(ParamRef "value")))) [subst A=nint, K=nint, V=nint]
  Func "identity" pub
    doc "The argument, unchanged. Works for any type because it touches nothing."
    typeparam "T"
    param x: T
    result T
      return ParamRef "x"
  Func "firstOf" pub
    doc "The first of two values of the same type."
    typeparam "T"
    param a: T
    param b: T
    result T
      return ParamRef "a"
