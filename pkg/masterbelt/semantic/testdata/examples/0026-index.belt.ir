  Func "at" pub
    param xs: list<int>
    param i: int
    result int | error
      return <none>
  Func "bumpFirst" pub
    result list<int>
      let "xs": list<int> = [IntLiteral "1", IntLiteral "2", IntLiteral "3"]
      assign "" = <none>
      return LocalRef "xs"
  Func "put" pub
    result map<string, int>
      let "m": map<string, int> = [StringLiteral "a": IntLiteral "1"]
      assign "" = <none>
      assign "" = <none>
