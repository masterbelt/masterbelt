Module
  Const "Xs"
    type list<nint>
    value [IntLiteral "10", IntLiteral "20", IntLiteral "30"]
    eval [10, 20, 30]
  Const "First"
    type nint | error
    value Reference -> "Xs".get(IntLiteral "0")
    eval 10
  Const "Third"
    type nint | error
    value Reference -> "Xs".get(IntLiteral "2")
    eval 30
  Const "Tbl"
    type map<string, nint>
    value [StringLiteral "sword": IntLiteral "100", StringLiteral "shield": IntLiteral "50"]
    eval ["sword": 100, "shield": 50]
  Const "Sword"
    type nint | error
    value Reference -> "Tbl".get(StringLiteral "sword")
    eval 100
  Const "Bumped"
    type list<nint>
    value bumpFirst()
    eval [99, 2, 3]
  Const "Put"
    type map<string, nint>
    value put()
    eval ["a": 10, "b": 2]
  Func "at" pub
    param xs: list<nint>
    param i: nint
    result nint | error
      return ParamRef "xs".get(ParamRef "i")
  Func "bumpFirst" pub
    result list<nint>
      let "xs": list<nint> = [IntLiteral "1", IntLiteral "2", IntLiteral "3"]
      assign "xs" = LocalRef "xs".set(IntLiteral "0", IntLiteral "99")
      return LocalRef "xs"
  Func "put" pub
    result map<string, nint>
      let "m": map<string, nint> = [StringLiteral "a": IntLiteral "1"]
      assign "m" = LocalRef "m".set(StringLiteral "a", IntLiteral "10")
      assign "m" = LocalRef "m".set(StringLiteral "b", IntLiteral "2")
      return LocalRef "m"
