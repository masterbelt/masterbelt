Module
  Const "Joined"
    type list<nint>
    value (([(IntLiteral "1" : nint), (IntLiteral "2" : nint)] : list<nint>).add(([(IntLiteral "3" : nint), (IntLiteral "4" : nint)] : list<nint>)) : list<nint>) [resolved add(other: self): self] [subst K=nint, T=nint, V=nint]
    eval [1, 2, 3, 4]
  Const "Added"
    type list<nint>
    value (([(IntLiteral "1" : nint), (IntLiteral "2" : nint)] : list<nint>).add((IntLiteral "3" : nint)) : list<nint>) [resolved add(element: T): self] [subst K=nint, T=nint, V=nint]
    eval [1, 2, 3]
  Const "NestedAdd"
    type list<list<nint>>
    value (([([(IntLiteral "1" : nint)] : list<nint>), ([(IntLiteral "2" : nint)] : list<nint>)] : list<list<nint>>).add(([(IntLiteral "3" : nint)] : list<nint>)) : list<list<nint>>) [resolved add(element: T): self] [subst K=nint, T=list<nint>, V=list<nint>]
    eval [[1], [2], [3]]
  Const "Pushed"
    type list<nint>
    value (([(IntLiteral "1" : nint), (IntLiteral "2" : nint)] : list<nint>).push((IntLiteral "3" : nint)) : list<nint>) [subst K=nint, T=nint, V=nint]
    eval [1, 2, 3]
  Const "Unshifted"
    type list<nint>
    value (([(IntLiteral "2" : nint), (IntLiteral "3" : nint)] : list<nint>).unshift((IntLiteral "1" : nint)) : list<nint>) [subst K=nint, T=nint, V=nint]
    eval [1, 2, 3]
  Const "Empty"
    type list<nint>
    value ([] : list<nint>)
    eval []
  Const "Last"
    type optional<nint>
    value (([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint)] : list<nint>).pop() : optional<nint>) [subst K=nint, T=nint, V=nint]
    eval 3
  Const "NoLast"
    type optional<nint>
    value ((Reference -> "Empty" : list<nint>).pop() : optional<nint>) [subst K=nint, T=nint, V=nint]
    eval null
  Const "First"
    type optional<nint>
    value (([(IntLiteral "1" : nint), (IntLiteral "2" : nint), (IntLiteral "3" : nint)] : list<nint>).shift() : optional<nint>) [subst K=nint, T=nint, V=nint]
    eval 1
  Const "NoFirst"
    type optional<nint>
    value ((Reference -> "Empty" : list<nint>).shift() : optional<nint>) [subst K=nint, T=nint, V=nint]
    eval null
  Func "orZero" pub
    param v: optional<nint>
    result nint
      match (ParamRef "v" : optional<nint>)
        arm nint n
          return (LocalRef "n" : nint)
        arm null
          return (IntLiteral "0" : nint)
  Assert "([1, 2] + [3, 4]).len() == 4"
    eval true
      ([1, 2] + [3, 4]).len() == 4
              ^         ^     ^
              |         4     true
              [1, 2, 3, 4]
  Assert "([1, 2] + 3).len() == 3"
    eval true
      ([1, 2] + 3).len() == 3
              ^    ^     ^
              |    3     true
              [1, 2, 3]
  Assert "[1, 2].push(3).len() == 3"
    eval true
      [1, 2].push(3).len() == 3
             ^       ^     ^
             |       3     true
             [1, 2, 3]
  Assert "[2, 3].unshift(1).len() == 3"
    eval true
      [2, 3].unshift(1).len() == 3
             ^          ^     ^
             [1, 2, 3]  3     true
  Assert "([[1], [2]] + [3]).len() == 3"
    eval true
      ([[1], [2]] + [3]).len() == 3
                  ^      ^     ^
                  |      3     true
                  [[1], [2], [3]]
  Assert "orZero([1, 2, 3].pop()) == 3"
    eval true
      orZero([1, 2, 3].pop()) == 3
      ^                ^      ^
      3                3      true
  Assert "orZero(Empty.pop()) == 0"
    eval true
      orZero(Empty.pop()) == 0
      ^      ^     ^      ^
      0      []    null   true
  Assert "orZero([1, 2, 3].shift()) == 1"
    eval true
      orZero([1, 2, 3].shift()) == 1
      ^                ^        ^
      1                1        true
  Assert "orZero(Empty.shift()) == 0"
    eval true
      orZero(Empty.shift()) == 0
      ^      ^     ^        ^
      0      []    null     true
