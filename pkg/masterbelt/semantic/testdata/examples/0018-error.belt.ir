Module
  Const "E"
    type error
    value error(StringLiteral "boom")
    eval error("boom")
  Const "M"
    type string
    value Reference -> "E".message()
    eval "boom"
  Const "P"
    type nint | error
    value parseLevel(StringLiteral "99")
    eval error("invalid level: 99")
  Func "parseLevel" pub
    param s: string
    result nint | error
      return error(StringLiteral "invalid level: ".add(ParamRef "s"))
  Assert "error(\"x\").message() == \"x\""
    eval true
      error("x").message() == "x"
      ^          ^         ^
      error("x") "x"       true
  Assert "E.message() == \"boom\""
    eval true
      E.message() == "boom"
      ^ ^         ^
      | "boom"    true
      error("boom")
  Assert "M == \"boom\""
    eval true
      M == "boom"
      ^ ^
      | true
      "boom"
