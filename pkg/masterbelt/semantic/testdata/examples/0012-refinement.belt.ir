Module
  Const "ServerPort"
    type Port
    value (adapt (IntLiteral "8080" : nint) : Port)
    eval 8080
  Const "MinPort"
    type Port
    value (adapt (IntLiteral "1" : nint) : Port)
    eval 1
  Const "MaxPort"
    type Port
    value (adapt (IntLiteral "65535" : nint) : Port)
    eval 65535
  Const "FullLevel"
    type Level
    value (adapt (IntLiteral "100" : nint) : Level)
    eval 100
  Const "ValidScore"
    type Score
    value (adapt (IntLiteral "75" : nint) : Score)
    eval 75
  Const "Unrefined"
    type nint
    value (IntLiteral "70000" : nint)
    eval 70000
  TypeDef "Level" pub
    doc "A character level between 0 and 100."
    body sbyte
    where (((self : Level).gteq((adapt (IntLiteral "0" : nint) : Level)) : bool).anan(((self : Level).lteq((adapt (IntLiteral "100" : nint) : Level)) : bool)) : bool)
  TypeDef "Port" pub
    doc "A TCP port number."
    body int
    where (((self : Port).gteq((adapt (IntLiteral "1" : nint) : Port)) : bool).anan(((self : Port).lteq((adapt (IntLiteral "65535" : nint) : Port)) : bool)) : bool)
  TypeDef "Percent" pub
    doc "A percentage from 0 to 100."
    body sbyte
    where (((self : Percent).gteq((adapt (IntLiteral "0" : nint) : Percent)) : bool).anan(((self : Percent).lteq((adapt (IntLiteral "100" : nint) : Percent)) : bool)) : bool)
    method "increment" pub
      doc "The next percentage point."
      result self
      return ((self : Percent).add((adapt (IntLiteral "1" : nint) : Percent)) : Percent)
  TypeDef "Score" pub
    doc "A score that is valid only when it lies in the 0..100 band."
    body int
    where ((self : Score).inBand() : bool)
    method "inBand" pub
      doc "Whether the score is within the valid band."
      result bool
      return (((self : Score).gteq((adapt (IntLiteral "0" : nint) : Score)) : bool).anan(((self : Score).lteq((adapt (IntLiteral "100" : nint) : Score)) : bool)) : bool)
