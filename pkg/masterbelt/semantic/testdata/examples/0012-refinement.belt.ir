Module
  Const "ServerPort"
    type Port
    value IntLiteral "8080"
    eval 8080
  Const "MinPort"
    type Port
    value IntLiteral "1"
    eval 1
  Const "MaxPort"
    type Port
    value IntLiteral "65535"
    eval 65535
  Const "FullLevel"
    type Level
    value IntLiteral "100"
    eval 100
  Const "ValidScore"
    type Score
    value IntLiteral "75"
    eval 75
  Const "Unrefined"
    type nint
    value IntLiteral "70000"
    eval 70000
  TypeDef "Level" pub
    doc "A character level between 0 and 100."
    body sbyte
    where self >= 0 && self <= 100
  TypeDef "Port" pub
    doc "A TCP port number."
    body int
    where self >= 1 && self <= 65535
  TypeDef "Percent" pub
    doc "A percentage from 0 to 100."
    body sbyte
    where self >= 0 && self <= 100
    method "increment" pub
      doc "The next percentage point."
      result self
      return self.add(IntLiteral "1")
  TypeDef "Score" pub
    doc "A score that is valid only when it lies in the 0..100 band."
    body int
    where self.inBand()
    method "inBand" pub
      doc "Whether the score is within the valid band."
      result bool
      return self.gteq(IntLiteral "0").anan(self.lteq(IntLiteral "100"))
