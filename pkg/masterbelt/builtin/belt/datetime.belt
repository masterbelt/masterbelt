use { bool } from "./bool.belt"
use { nint } from "./signed.belt"
use { comparable, orderable } from "./operators.belt"

/// An instant in time: a D-prefixed ISO-8601 literal (D2009-03-31T23:59:59.000Z, offsets allowed), normalized to UTC with millisecond precision.
pub type datetime = builtin impl {
  /// The + operator: the instant a duration later.
  pub extern fn add(amount: duration): self
  /// The - operator: the span from another instant to this one.
  pub extern fn sub(other: self): duration
  /// The - operator: the instant a duration earlier.
  pub extern fn sub(amount: duration): self
} impl comparable {
  /// The == operator.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl orderable {
  /// The < operator: whether this instant is earlier.
  pub extern fn lt(other: self): bool
  /// The <= operator.
  pub extern fn lteq(other: self): bool
  /// The > operator: whether this instant is later.
  pub extern fn gt(other: self): bool
  /// The >= operator.
  pub extern fn gteq(other: self): bool
}

/// A span of time: concatenated digit+unit groups (3w4d5h6m7s8ms; w/d/h/m/s/ms), totalled to milliseconds.
pub type duration = builtin impl {
  /// The + operator: the sum of two spans.
  pub extern fn add(other: self): self
  /// The + operator: the instant a span after a datetime.
  pub extern fn add(at: datetime): datetime
  /// The - operator: the difference of two spans.
  pub extern fn sub(other: self): self
  /// The * operator: the span repeated a whole number of times.
  pub extern fn mul(factor: nint): self
} impl comparable {
  /// The == operator.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl orderable {
  /// The < operator: whether this span is shorter.
  pub extern fn lt(other: self): bool
  /// The <= operator.
  pub extern fn lteq(other: self): bool
  /// The > operator: whether this span is longer.
  pub extern fn gt(other: self): bool
  /// The >= operator.
  pub extern fn gteq(other: self): bool
}
