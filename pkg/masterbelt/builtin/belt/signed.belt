/// The arbitrary-precision integer: the type of an un-annotated integer literal. It has no fixed range and fits wherever a sized integer is expected.
pub type nint = builtin impl {
  /// The unary - operator: the negation.
  pub extern fn neg(): self
} impl comparable {
  /// The == operator.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl orderable {
  /// The < operator.
  pub extern fn lt(other: self): bool
  /// The <= operator.
  pub extern fn lteq(other: self): bool
  /// The > operator.
  pub extern fn gt(other: self): bool
  /// The >= operator.
  pub extern fn gteq(other: self): bool
} impl numeric {
  /// The unary + operator: the value unchanged.
  pub extern fn pos(): self

  /// The + operator: the sum.
  pub extern fn add(other: self): self
  /// The - operator: the difference.
  pub extern fn sub(other: self): self
  /// The * operator: the product.
  pub extern fn mul(other: self): self
  /// The / operator: the quotient. A zero divisor is a compile-time error.
  pub extern fn div(other: self): self
  /// The % operator: the remainder. A zero divisor is a compile-time error.
  pub extern fn rem(other: self): self
}

/// A signed 8-bit integer (-128 to 127).
pub type sbyte = builtin impl {
  /// The largest representable value (127).
  pub const Max = builtin
  /// The smallest representable value (-128).
  pub const Min = builtin

  /// The unary - operator: the negation.
  pub extern fn neg(): self
} impl comparable {
  /// The == operator.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl orderable {
  /// The < operator.
  pub extern fn lt(other: self): bool
  /// The <= operator.
  pub extern fn lteq(other: self): bool
  /// The > operator.
  pub extern fn gt(other: self): bool
  /// The >= operator.
  pub extern fn gteq(other: self): bool
} impl numeric {
  /// The unary + operator: the value unchanged.
  pub extern fn pos(): self

  /// The + operator: the sum.
  pub extern fn add(other: self): self
  /// The - operator: the difference.
  pub extern fn sub(other: self): self
  /// The * operator: the product.
  pub extern fn mul(other: self): self
  /// The / operator: the quotient. A zero divisor is a compile-time error.
  pub extern fn div(other: self): self
  /// The % operator: the remainder. A zero divisor is a compile-time error.
  pub extern fn rem(other: self): self
}

