use { bool } from "./bool.belt"
use { nint } from "./signed.belt"
use { error } from "./error.belt"

// foldable, list, and map live together in this one file because they refer to
// one another: foldable's provided methods return list (map/filter/keys/values),
// while list and map impl foldable. A single file lets the resolver — which runs
// multiple passes within a file — tie the knot, where splitting them across files
// would need an import cycle the loader does not resolve. This mirrors how
// datetime and duration share datetime.belt for their mutual operators.

/// A behaviour over a keyed collection: a type implements the single required
/// fold (the primitive that visits every element), and the provided methods —
/// count, any, all, and the list-returning map, filter, keys, values — come for
/// free, each defined on top of fold. iterability is foldable. A type opts in by
/// writing `impl foldable<K, V>` at its own definition site (no structural
/// auto-fit, no orphan impls); an interface may also be written in a type-
/// requirement position (c: foldable<nint, V>), where the value's usable methods
/// are fixed to these.
pub interface foldable<K, V> {
  /// The fold: visit every element in order, threading an accumulator from init
  /// through step. This is the one method an implementor must supply; every
  /// provided method below is defined on top of it.
  fold<A>(init: A, step: fn(acc: A, key: K, value: V): A): A

  /// The number of elements.
  pub count(): nint {
    return fold(0, fn(acc, key, value) -> acc + 1)
  }

  /// Whether any element satisfies the predicate.
  pub any(pred: fn(value: V): bool): bool {
    return fold(false, fn(acc, key, value) -> acc || pred(value))
  }

  /// Whether every element satisfies the predicate.
  pub all(pred: fn(value: V): bool): bool {
    return fold(true, fn(acc, key, value) -> acc && pred(value))
  }

  /// A list of f applied to each value, in fold order.
  pub map<U>(f: fn(value: V): U): list<U> {
    return fold([], fn(acc, key, value) -> acc.append(f(value)))
  }

  /// A list of the values satisfying the predicate, in fold order.
  pub filter(pred: fn(value: V): bool): list<V> {
    return fold([], fn(acc, key, value) -> pred(value) ? acc.append(value) : acc)
  }

  /// A list of the keys, in fold order.
  pub keys(): list<K> {
    return fold([], fn(acc, key, value) -> acc.append(key))
  }

  /// A list of the values, in fold order.
  pub values(): list<V> {
    return fold([], fn(acc, key, value) -> acc.append(value))
  }
}

/// An ordered sequence of T values, written [a, b, c].
pub type list<T> = builtin<T> impl {
  /// The number of elements.
  pub extern fn len(): nint

  /// A new list: func applied to each element, in order.
  pub extern fn map(func: fn(item: T): R): list<R>

  /// A new list with value appended at the end, leaving this one unchanged.
  pub extern fn append(value: T): self

  /// The element at index, or an error when the index is out of range. The
  /// result is a union (T | error) because a read can miss; handle the error.
  pub extern fn get(index: nint): T | error

  /// A new list with index replaced by value, leaving this one unchanged. An
  /// index past the end is a compile-time error (index_out_of_range).
  pub extern fn set(index: nint, value: T): self

  /// The + operator: the concatenation.
  pub extern fn add(other: self): self

  /// The == operator: element-wise equality.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl foldable<nint, T> {
  /// The required primitive: visit each element with its index as the key,
  /// threading the accumulator. The provided count/any/all/map/filter/... are
  /// defined on top of this.
  pub extern fn fold(init: A, step: fn(acc: A, key: nint, value: T): A): A
}

/// A key-value mapping, written [k: v, ...].
pub type map<K, V> = builtin<K, V> impl {
  /// The number of entries.
  pub extern fn len(): nint

  /// The value for key, or an error when the key is not present. The result is
  /// a union (V | error) because a lookup can miss; handle the error.
  pub extern fn get(key: K): V | error

  /// A new map with key set to value — an upsert that updates an existing key
  /// or adds a new one — leaving this one unchanged. A map write always succeeds.
  pub extern fn set(key: K, value: V): self

  /// The + operator: the merge of the two maps.
  pub extern fn add(other: self): self

  /// The == operator: entry-wise equality.
  pub extern fn eql(other: self): bool
  /// The != operator.
  pub extern fn neq(other: self): bool
} impl foldable<K, V> {
  /// The required primitive: visit each entry with its key and value, threading
  /// the accumulator. The provided count/any/all/map/filter/keys/values are
  /// defined on top of this.
  pub extern fn fold(init: A, step: fn(acc: A, key: K, value: V): A): A
}
