use { nint } from "./signed.belt"
use { foldable } from "./collection.belt"

/// An inclusive sequence of integers, constructed with range(start, end): the
/// values start, start+1, ..., end — both bounds included — with an end below
/// start being the empty sequence. It is constructed by the two-argument conversion form the way
/// error("msg") is by the one-argument form — a native constructor that builds
/// the value — and is not a stored collection: its bounds are kept lazily, so a
/// wide range costs nothing until it is walked.
///
/// range impls foldable<nint, nint>, so it iterates with for and carries the whole
/// provided method set (count, any, all, map, filter, keys, values) for free.
/// Its key is the 0-based position — like a list's index — and its value is the
/// element, so for...of binds the element and for...in binds the position; the
/// K/V semantics are list's exactly.
pub type range = builtin impl foldable<nint, nint> {
  /// The required primitive: visit each element in order with its 0-based
  /// position as the key, threading the accumulator. The provided
  /// count/any/all/map/filter/keys/values are defined on top of this.
  pub extern fn fold(init: A, step: fn(acc: A, key: nint, value: nint): A): A
}
