use { bool } from "./bool.belt"
use { int } from "./int.belt"

/// A behaviour over a keyed collection: a type implements the single required
/// fold (the primitive that visits every element), and the provided methods —
/// count, any, all — come for free, each defined on top of fold. iterability is
/// foldable. A type opts in by writing `impl foldable<K, V>` at its own
/// definition site (no structural auto-fit, no orphan impls); an interface may
/// also be written in a type-requirement position (c: foldable<int, V>), where
/// the value's usable methods are fixed to these.
///
/// The list-returning provided methods (map, filter, keys, values) the design
/// also envisions are not declared here yet: they return list<U>, which would
/// make foldable.belt import list.belt while list.belt impls foldable — a
/// prelude import cycle the loader does not yet resolve. They are exercised in
/// the language-level example (a user interface that returns list) where no such
/// prelude cycle exists.
pub interface foldable<K, V> {
  /// The fold: visit every element in order, threading an accumulator from init
  /// through step. This is the one method an implementor must supply; every
  /// provided method below is defined on top of it.
  fold<A>(init: A, step: fn(acc: A, key: K, value: V): A): A

  /// The number of elements.
  pub count(): int {
    return fold(0, fn(acc, key, value) -> acc + 1)
  }

  /// Whether any element satisfies the predicate.
  pub any(pred: fn(value: V): bool): bool {
    return fold(false, fn(acc, key, value) -> acc || pred(value))
  }

  /// Whether every element satisfies the predicate.
  pub all(pred: fn(value: V): bool): bool {
    return fold(true, fn(acc, key, value) -> acc && pred(value))
  }
}
