// MarshalText renders the node and its subtree in the exact text form.
func (n *Root) MarshalText() ([]byte, error) {
	var w treetext.Writer
	w.Line(0, "Root")
	if err := writeRoot(&w, n, 1); err != nil {
		return nil, err
	}
	return w.Bytes(), nil
}

// UnmarshalText parses the exact text form back into the node. The result
// is detached: the unexported syntax backpointers stay nil by construction.
func (n *Root) UnmarshalText(data []byte) error {
	e, err := treetext.Parse(data)
	if err != nil {
		return err
	}
	if e.Head != "Root" {
		return fmt.Errorf("treetext: line %d: root is %s, want Root", e.Line, e.Head)
	}
	v, err := decodeRoot(e)
	if err != nil {
		return err
	}
	*n = *v
	return nil
}

// writeWrap emits n's fields beneath an already-written heading line.
func writeWrap(w *treetext.Writer, n *Wrap, depth int) error {
	if len(n.Entries) == 0 {
		w.Line(depth, "Entries: "+treetext.Nil)
	} else {
		w.Line(depth, "Entries:")
		for _, item := range n.Entries {
			if item == nil {
				w.Line(depth+1, treetext.Nil)
				continue
			}
			w.Line(depth+1, "Pair")
			if err := writePair(w, item, depth+2); err != nil {
				return err
			}
		}
	}
	return nil
}

// decodeWrap builds a Wrap from its element.
func decodeWrap(e *treetext.Element) (*Wrap, error) {
	if err := treetext.ExpectFields(e, "Entries"); err != nil {
		return nil, err
	}
	n := &Wrap{}
	switch f := e.Fields[0]; {
	case f.Inline == treetext.Nil:
	case f.Items == nil:
		return nil, fmt.Errorf("treetext: line %d: field %s: expected a list", f.Line, f.Name)
	default:
		out := make([]*Pair, 0, len(f.Items))
		for j := range f.Items {
			item := &f.Items[j]
			if item.Head == treetext.Nil {
				out = append(out, nil)
				continue
			}
			if item.Head != "Pair" {
				return nil, fmt.Errorf("treetext: line %d: %s is not a Pair", item.Line, item.Head)
			}
			v, err := decodePair(item)
			if err != nil {
				return nil, err
			}
			out = append(out, v)
		}
		n.Entries = out
	}
	return n, nil
}

// MarshalText renders the node and its subtree in the exact text form.
func (n *Wrap) MarshalText() ([]byte, error) {
	var w treetext.Writer
	w.Line(0, "Wrap")
	if err := writeWrap(&w, n, 1); err != nil {
		return nil, err
	}
	return w.Bytes(), nil
}

// writeExprField emits one Expr-typed field: the nil marker or the concrete
// node behind its heading.
func writeExprField(w *treetext.Writer, depth int, name string, v Expr) error {
	switch n := v.(type) {
	case nil:
		w.Line(depth, name+": "+treetext.Nil)
		return nil
	case *Leaf:
		if n == nil {
			w.Line(depth, name+": "+treetext.Nil)
			return nil
		}
		w.Line(depth, name+": Leaf")
		return writeLeaf(w, n, depth+1)
	case *Wrap:
		if n == nil {
			w.Line(depth, name+": "+treetext.Nil)
			return nil
		}
		w.Line(depth, name+": Wrap")
		return writeWrap(w, n, depth+1)
	default:
		return fmt.Errorf("treetext: field %s: unsupported Expr %T", name, v)
	}
}

// writeExprItem emits one Expr-typed list item: the nil marker line or the
// concrete element.
func writeExprItem(w *treetext.Writer, depth int, v Expr) error {
	switch n := v.(type) {
	case nil:
		w.Line(depth, treetext.Nil)
		return nil
	case *Leaf:
		if n == nil {
			w.Line(depth, treetext.Nil)
			return nil
		}
		w.Line(depth, "Leaf")
		return writeLeaf(w, n, depth+1)
	case *Wrap:
		if n == nil {
			w.Line(depth, treetext.Nil)
			return nil
		}
		w.Line(depth, "Wrap")
		return writeWrap(w, n, depth+1)
	default:
		return fmt.Errorf("treetext: unsupported Expr %T", v)
	}
}

// decodeExpr decodes an element into its Expr implementation.
func decodeExpr(e *treetext.Element) (Expr, error) {
	switch e.Head {
	case "Leaf":
		return decodeLeaf(e)
	case "Wrap":
		return decodeWrap(e)
	default:
		return nil, fmt.Errorf("treetext: line %d: %s is not a known Expr", e.Line, e.Head)
	}
}

// decodeExprField decodes one Expr-typed field: the nil marker or the node.
func decodeExprField(f treetext.Field) (Expr, error) {
	if f.Inline == treetext.Nil {
		return nil, nil
	}
	if f.Node == nil {
		return nil, fmt.Errorf("treetext: line %d: field %s: expected a node", f.Line, f.Name)
	}
	return decodeExpr(f.Node)
}

// treeStructs lists one typed nil pointer per tree struct, for the
// field-sensitivity pin.
var treeStructs = []any{
	(*Cell)(nil),
	(*Leaf)(nil),
	(*Pair)(nil),
	(*Root)(nil),
	(*Wrap)(nil),
}

// writeTree dispatches a tree struct to its writer (test support); the
// bool reports whether v is a known tree struct.
func writeTree(w *treetext.Writer, v any, depth int) (bool, error) {
	switch n := v.(type) {
	case *Cell:
		w.Line(depth, "Cell")
		return true, writeCell(w, n, depth+1)
	case *Leaf:
		w.Line(depth, "Leaf")
		return true, writeLeaf(w, n, depth+1)
	case *Pair:
		w.Line(depth, "Pair")
		return true, writePair(w, n, depth+1)
	case *Root:
		w.Line(depth, "Root")
		return true, writeRoot(w, n, depth+1)
	case *Wrap:
		w.Line(depth, "Wrap")
		return true, writeWrap(w, n, depth+1)
	default:
		return false, nil
	}
}

// treeExcluded records the exported fields excluded from the format by a
// tree:"-" tag, per struct: the explicit no-output decisions, pinned by
// test. Unexported fields (the syntax backpointers) are excluded by
// construction and do not appear here.
var treeExcluded = map[string][]string{
	"Root": {"Skip"},
}
