{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "masterbelt",
  "scopeName": "source.masterbelt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.masterbelt",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.masterbelt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.masterbelt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.masterbelt",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.masterbelt",
          "match": "\\b(builtin|const|extern|false|fn|impl|null|pub|return|self|true|type)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.masterbelt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.masterbelt",
          "match": "="
        },
        {
          "name": "punctuation.separator.type.masterbelt",
          "match": ":"
        }
      ]
    }
  }
}
