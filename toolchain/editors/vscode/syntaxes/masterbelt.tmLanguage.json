{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "masterbelt",
  "scopeName": "source.masterbelt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#datetimes"
    },
    {
      "include": "#durations"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.masterbelt",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.masterbelt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.masterbelt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "datetimes": {
      "patterns": [
        {
          "name": "constant.numeric.datetime.masterbelt",
          "match": "\\bD[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?(Z|[+-][0-9]{2}:[0-9]{2})"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.masterbelt",
          "match": "\\b([0-9]+(ms|w|d|h|m|s))+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.masterbelt",
          "match": "\\b(assert|builtin|const|extern|false|fn|from|impl|null|pub|return|self|true|type|use|where)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.masterbelt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.masterbelt",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.masterbelt",
          "match": "="
        },
        {
          "name": "keyword.operator.masterbelt",
          "match": ":"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.masterbelt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.masterbelt",
              "match": "\\\\(u\\{[0-9A-Fa-f]{1,6}\\}|[nrt0\\\\\"])"
            }
          ]
        }
      ]
    }
  }
}
