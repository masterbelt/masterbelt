/// A doc comment.
pub type Color = { channel: nint } impl {
  pub fn make(value: nint): Color {
    return Color{ channel: value } // a line comment
  }
}

pub enum Tier {
  Bronze, Silver
}

pub fn paint(c: Color): nint {
  return c.channel
}

const Base: nint = 1 + 2
const Made = paint(Color{ channel: 3 })

pub master Skill {
  record { id: nint }
  primary id
}

// Reserved words as names: record fields, a member, a type projection, and a
// parameter — each colours as its role, not as the keyword.
pub type Schema = { match: nint, of: nint }
pub type OfType = Schema.of
pub fn scan(s: Schema, type: nint): nint {
  return s.match
}
