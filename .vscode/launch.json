{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run masterbelt Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/toolchain/editors/vscode",
        "${workspaceFolder}/pkg/belt/testdata/examples",
        "${workspaceFolder}/pkg/belt/testdata/examples/0001-const.belt"
      ],
      "env": {
        "MASTERBELT_SERVER_PATH": "${workspaceFolder}/bin/masterbelt"
      },
      "outFiles": ["${workspaceFolder}/toolchain/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
